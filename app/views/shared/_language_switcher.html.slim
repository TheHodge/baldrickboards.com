/ Language Switcher
.relative.group
  button class="#{'border-indigo-500 text-gray-900' if params[:locale].present?} border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors"
    = I18n.locale.upcase
    svg.ml-1.h-4.w-4 fill="currentColor" viewBox="0 0 20 20"
      path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"
  .absolute.right-0.mt-2.w-32.bg-white.rounded-md.shadow-lg.opacity-0.invisible.group-hover:opacity-100.group-hover:visible.transition-all.duration-200.z-50
    .py-1
      = link_to "English", url_for(locale: :en), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{'bg-gray-100 font-semibold' if I18n.locale == :en}"
      = link_to "Español", url_for(locale: :es), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{'bg-gray-100 font-semibold' if I18n.locale == :es}"
      = link_to "Français", url_for(locale: :fr), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{'bg-gray-100 font-semibold' if I18n.locale == :fr}"
      = link_to "Deutsch", url_for(locale: :de), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{'bg-gray-100 font-semibold' if I18n.locale == :de}"
