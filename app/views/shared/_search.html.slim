- variant = local_assigns[:variant] || :default
- wrapper_class = variant == :nav ? "nav-search bb-search" : (variant == :mobile ? "mm-search bb-search" : "bb-search")
div data-controller="search" class=wrapper_class
  svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"
    path d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z"
  input type="text" placeholder="Search boards, FAQ… (⌘K)" data-search-target="input"
  .bb-search-results.hidden data-search-target="results"
