- newsletter_heading = local_assigns[:heading].presence || @newsletter_heading.presence || 'Get the latest Baldrick updates to your inbox.'
- newsletter_description = local_assigns[:description].presence || @newsletter_description.presence || 'New firmware, guides and the occasional silly thing. No more than your display can handle.'

section.news#newsletter
  .wrap
    .news-card
      div
        .sec-kick
          span.bar
          span.annot Newsletter
        h3= newsletter_heading
        p= newsletter_description
      div
        = form_with model: NewsletterSubscriber.new, url: newsletter_subscribers_path, html: { class: 'news-form', data: { turbo: false } } do |form|
          = form.email_field :email, placeholder: 'you@example.com', required: true
          = form.button 'Subscribe', type: 'submit', class: 'btn btn-solid'
        p.news-fine We respect your privacy. Unsubscribe whenever you like.
