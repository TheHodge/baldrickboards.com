nav.admin-subnav data-controller="mobile-menu"
  .wrap.admin-subnav-inner
    = link_to 'Admin', admin_root_path, class: 'admin-subnav-brand'
    .admin-subnav-scroll
      - menu_items.each do |item|
        = link_to item[:title], item[:path], class: "admin-subnav-link#{' is-active' if current_page?(item[:path])}"
    = link_to 'Logout', admin_logout_path, method: :delete, class: 'admin-subnav-logout'
    button.admin-subnav-toggle type="button" data-action="click->mobile-menu#toggle" aria-label="Admin menu"
      svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"
  .admin-subnav-mobile.hidden data-mobile-menu-target="menu"
    - menu_items.each do |item|
      = link_to item[:title], item[:path], class: "admin-subnav-mobile-link#{' is-active' if current_page?(item[:path])}"
    = link_to 'Logout', admin_logout_path, method: :delete, class: 'admin-subnav-mobile-link'
