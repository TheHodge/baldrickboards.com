= render 'shared/support_page', page_title: t('faq.title'), current_page: 'FAQ', parent_page: true, page_subtitle: t('faq.subtitle'), document_title: t('og.pages.faq.title'), eye_label: 'FAQ', meta: ['Setup & troubleshooting', 'Networking', 'Firmware'], toc: site_faq_toc do
  p.lead= t('faq.description')

  .prose.faq-prose
    = render 'boards/shared/faq_accordion', questions: site_faq_questions, anchors: true

    = render 'boards/shared/faq_foot'

    .callout.note.faq-help
      svg.ci viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
        path d="M12 16v-4m0-4h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0z"
      div
        b Any other questions?
        p
          | Board-specific answers live on each controller's FAQ page. For troubleshooting steps and what to include when posting, read the
          = link_to ' Asking for Help checklist', support_asking_for_help_path, class: 'lnk'
          | .
