- content_for :title, 'Baldrick Breakthroughs - Baldrick Board Documentation'

section.hero-blueprint
  .wrap.inner
    nav.crumb
      = link_to 'Home', root_path
      span.sep= '/'
      span.cur Baldrick Breakthroughs
    .eye
      span.bar
      span.annot Baldrick Breakthroughs
    h1 Baldrick Breakthroughs
    p.sub Innovation, ecosystem features and the infrastructure that makes Baldrick boards a bit special.
    .meta
      span 6 breakthroughs
      span Networking · effects · compliance
      span Updated for Baldrickboard

section.catalog
  .wrap
    p.catalog-lead From board-to-board networking to built-in effects and formal certification — the breakthroughs are the glue that turns a pile of controllers into a show.
    .cat-grid
      - breakthrough_pages.each do |page|
        = breakthrough_card(page)

section.cta
  .wrap
    h2 Ready to pick a board?
    p Explore the full range and find the right controller for your display.
    .cta-btns
      = link_to boards_path, class: 'btn btn-bone' do
        | Explore the range
        span.ar →
      = link_to where_to_buy_baldrick_boards_path, class: 'btn btn-clear' do
        | Where to buy
