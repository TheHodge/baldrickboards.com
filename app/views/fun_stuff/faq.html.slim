= render 'shared/fun_stuff_page', page_title: 'FAQ', current_page: 'FAQ', page_subtitle: 'Common questions and answers about Baldrick products', document_title: 'FAQ - Fun Stuff', meta: ['General help', 'Setup & troubleshooting', 'Compatibility'], toc: fun_stuff_faq_toc do
  p.lead Find answers to the most commonly asked questions about Baldrick products, setup, troubleshooting, and more.

  .prose.faq-prose
    .callout.info
      span.ic
        svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          circle cx="12" cy="12" r="10"
          path d="M12 16v-4M12 8h.01"
      div
        span.lbl Can't find your answer?
        p.bd Check our support page or join our Facebook group for additional help.

    - fun_stuff_faq_sections.each do |section|
      section id=section[:id]
        h2
          span.hk
            span.bar
            span.annot FAQ
          = section[:title]

        .faq-list
          - section[:items].each_with_index do |item, index|
            details.faq id="#{section[:id]}-#{index}"
              summary
                = item[:question]
                span.ic
                  svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    path d="M12 5v14M5 12h14"
              .ans
                == item[:answer]

    .next-grid
      = link_to support_path, class: 'next-card' do
        .top
          span.kind Support
          span.go →
        h4 Contact support
        p Questions not covered here? Start with our support hub.
      = link_to t('facebook_group_url'), class: 'next-card', target: '_blank' do
        .top
          span.kind Community
          span.go →
        h4 Facebook group
        p Connect with other Baldrick users for tips and advice.

section.cta
  .wrap
    h2 Board-specific questions?
    p Each controller has its own FAQ with wiring and firmware detail.
    .cta-btns
      = link_to boards_path, class: 'btn btn-bone' do
        | Explore boards
        span.ar →
      = link_to fun_stuff_path, class: 'btn btn-clear' do
        | All fun stuff
