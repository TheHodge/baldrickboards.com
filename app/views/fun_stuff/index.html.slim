- content_for :title, 'Fun Stuff - Baldrick Board Documentation'

section.hero-blueprint
  .wrap.inner
    nav.crumb
      = link_to 'Home', root_path
      span.sep= '/'
      span.cur Fun Stuff
    .eye
      span.bar
      span.annot Fun Stuff
    h1 Fun Stuff
    p.sub Downloads, community gems and the slightly silly corners of the Baldrick docs.
    .meta
      span 7 pages
      span STLs · release notes · showcase
      span Updated for Baldrickboard

section.catalog
  .wrap
    p.catalog-lead Firmware changelogs, printable mounts, dimension drawings, customer photos and Panic Mode — the bits that don't fit neatly on a board manual.
    .cat-grid
      - fun_stuff_pages.each do |page|
        = fun_stuff_card(page)

section.cta
  .wrap
    h2 Looking for board docs?
    p Manuals, FAQs and wiring guides live with each controller in the Boards section.
    .cta-btns
      = link_to boards_path, class: 'btn btn-bone' do
        | Explore boards
        span.ar →
      = link_to fun_stuff_release_notes_path, class: 'btn btn-clear' do
        | Release notes
