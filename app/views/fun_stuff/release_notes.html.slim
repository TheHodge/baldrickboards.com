= render 'shared/fun_stuff_page', page_title: 'Release Notes', current_page: 'Release Notes', page_subtitle: 'Latest updates and improvements to Baldrick products', document_title: 'Release Notes - Fun Stuff', meta: ['Firmware changelog', 'All boards', 'Sidebar navigation'], toc: release_notes_toc, toc_class: 'toc--releases' do
  .prose.release-notes
    = render 'fun_stuff/release_notes_content'

    section#support
      h2
        span.hk
          span.bar
          span.annot Help
        | Support & troubleshooting

      p If you encounter any issues during the update process or have questions about new features, our support team is here to help.

      .next-grid
        = link_to support_path, class: 'next-card' do
          .top
            span.kind Support
            span.go →
          h4 Need help?
          p Our team can assist with update issues or questions about new features.
        = link_to t('facebook_group_url'), class: 'next-card', target: '_blank' do
          .top
            span.kind Community
            span.go →
          h4 Facebook group
          p Discuss updates and share experiences with other builders.

section.cta
  .wrap
    h2 Keep your boards current
    p Updates ship through the web interface — check System when your board nudges you.
    .cta-btns
      = link_to boards_path, class: 'btn btn-bone' do
        | Board manuals
        span.ar →
      = link_to fun_stuff_path, class: 'btn btn-clear' do
        | All fun stuff
