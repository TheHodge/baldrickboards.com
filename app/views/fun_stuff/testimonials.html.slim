= render 'shared/fun_stuff_page', page_title: t('views.fun_stuff.testimonials.header.title'), current_page: 'Testimonials', page_subtitle: t('views.fun_stuff.testimonials.header.subtitle'), document_title: t('views.fun_stuff.testimonials.title'), meta: ['Customer stories', 'Real displays', 'Community voices'] do
  p.lead = t('views.fun_stuff.testimonials.content.description')

  .prose
    .testimonial-grid
      - t('views.fun_stuff.testimonials.content.testimonials').each do |_key, testimonial|
        .testimonial-card
          - if testimonial[:image].present?
            .testimonial-img
              = image_tag "testimonials/#{testimonial[:image]}", alt: "Testimonial from #{testimonial[:author]}"
          blockquote = "\"#{testimonial[:quote]}\""
          .testimonial-author
            .avatar = testimonial[:author].split(' ').map(&:first).join
            div
              strong = testimonial[:author]
              - if testimonial[:location].present?
                span = testimonial[:location].html_safe
              - if testimonial[:board].present?
                span.board = testimonial[:board].html_safe

    .callout.info
      span.ic
        svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          path d="M12 20h9M8 4h9M5 9h14M5 14h14"
      div
        span.lbl Share your experience
        p.bd
          | Have you used Baldrick Boards in your display? We'd love to hear about it —
          = link_to ' submit your testimonial', new_feedback_path
          | .

    .next-grid
      = link_to t('facebook_group_url'), class: 'next-card', target: '_blank' do
        .top
          span.kind Community
          span.go →
        h4 Join our group
        p Connect with other Baldrick users and share your projects.
      = link_to fun_stuff_customer_showcase_path, class: 'next-card' do
        .top
          span.kind Gallery
          span.go →
        h4 Customer showcase
        p See the incredible displays our talented customers have created.

section.cta
  .wrap
    h2 Want to be featured?
    p Send us photos of your show — we love seeing what you build.
    .cta-btns
      = link_to new_feedback_path, class: 'btn btn-bone' do
        | Get in touch
        span.ar →
      = link_to fun_stuff_customer_showcase_path, class: 'btn btn-clear' do
        | View gallery
