- content_for :title, "Baldrick Boards — Controllers for serious light displays"

div data-controller="reveal"
  section.hero
    .wrap.hero-grid
      .hero-copy
        .hero-eye
          span.bar
          span.annot Pixel · DMX · Relay · Input controllers
        h1 Controllers that create <span class="hl">joy</span> around the world.
        p.hero-sub From back gardens to theatres, gigs & tours to mega churches - powerful, flexible hardware for pixels, DMX, relays and inputs. 
        .hero-cta
          = link_to "#cats", class: "btn btn-solid" do
            | Find the right board
            span.ar →
          = link_to "#range", class: "btn btn-line" do
            | Browse the range

      .hero-board data-controller="hero-rotator" data-action="mouseenter->hero-rotator#pause mouseleave->hero-rotator#resume"
        .board-rotator
          - [["baldrick8", "Baldrick8"], ["baldrick17", "Baldrick17"], ["baldrickdmx", "BaldrickDMX"], ["baldrickswitchy", "BaldrickSwitchy"], ["baldrickinput8", "BaldrickInput8"], ["baldricksignals", "BaldrickSignals"]].each_with_index do |(slug, name), index|
            = link_to board_path(slug), class: "brot#{' on' if index == 0}", data: { hero_rotator_target: "slide", nm: name } do
              = image_tag "#{slug}.png", alt: name
        .brot-foot
          = link_to board_path("baldrick8"), class: "brot-name", data: { hero_rotator_target: "name" } do
            | Baldrick8
          .brot-dots data-hero-rotator-target="dots"

  .ticker aria-hidden="true"
    .ticker-track
      - items = ["Trusted by thousands", "ArtNet / E1.31 / sACN / DPP", "Pixels, Relays, Sensors, Buttons & DMX", "Free STL mounts", "5V to 48V DC (on most boards)", "Designed in the UK", "CE + UKCA + RoHS"]
      - 2.times do
        - items.each do |item|
          span.ticker-item = item

          
  section.sec.cats#cats
    .wrap
      .sec-head-row
        div
          .sec-kick.rv
            span.bar
            span.annot Start here
          h2.rv data-d="1" What are you controlling?
        p.sec-lead.rv data-d="2" Tell us what you're driving and we'll point you to the right board. The full range is just below.
      .cat-grid.rv data-d="1"
        = link_to boards_pixel_controllers_path, class: "catx" do
          span.ci
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
              path d="M5 4v16M9 4v16M13 4v16M17 4v16"
              circle cx="5" cy="8" r="1.4" fill="currentColor"
              circle cx="9" cy="14" r="1.4" fill="currentColor"
              circle cx="13" cy="9" r="1.4" fill="currentColor"
              circle cx="17" cy="15" r="1.4" fill="currentColor"
          h3 Pixels
          p Strings, props, matrices, trees and mega builds.
        = link_to boards_dmx_controllers_path, class: "catx" do
          span.ci
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
              circle cx="12" cy="12" r="9"
              circle cx="12" cy="8" r="1.3" fill="currentColor"
              circle cx="8.5" cy="14" r="1.3" fill="currentColor"
              circle cx="15.5" cy="14" r="1.3" fill="currentColor"
          h3 DMX
          p Moving heads, dimmers and stage fixtures.
        = link_to boards_relay_controllers_path, class: "catx" do
          span.ci
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
              path d="M9 2v6M15 2v6M7 8h10v3a5 5 0 0 1-10 0z"
              path d="M12 16v6"
          h3 Relays
          p Switch mains-powered and real-world devices.
        = link_to boards_interactive_controllers_path, class: "catx" do
          span.ci
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
              path d="M9 11V6a2 2 0 1 1 4 0v5"
              path d="M13 11V8a1.8 1.8 0 1 1 3.6 0v3"
              path d="M16.6 11a1.8 1.8 0 1 1 3.4 0v3a7 7 0 0 1-7 7h-1a7 7 0 0 1-6-3.5L4 15a1.8 1.8 0 0 1 3-2l1.5 2"
          h3 Inputs & Sensors
          p Buttons, triggers, beam breaks and switches.
        = link_to board_path("baldricksignals"), class: "catx" do
          span.ci
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
              path d="M4 20V4M4 20h16"
              rect x="7" y="12" width="3" height="5"
              rect x="12" y="8" width="3" height="9"
              rect x="17" y="5" width="3" height="12"
          h3 Monitoring
          p Something a little bit special.

  section.sec.range#range
    .wrap
      .sec-head-row
        div
          .sec-kick.rv
            span.bar
            span.annot The full family
          h2.rv data-d="1" The full family.
        p.sec-lead.rv data-d="2" Each board is special in it's own way but remember they get lonley so it's best to buy more than one!
      .range-strip.rv data-d="1"
        - [["baldrick8", "Baldrick8"], ["baldrick17", "Baldrick17"], ["baldrickdmx", "BaldrickDMX"], ["baldrickswitchy", "BaldrickSwitchy"], ["baldrickinput8", "BaldrickInput8"], ["baldrickinput1", "BaldrickInput1"], ["baldricksignals", "BaldrickSignals"]].each do |slug, name|
          = link_to board_path(slug), class: "brd" do
            .brd-vis
              = image_tag "#{slug}.png", alt: name
            .nm = name

  section.sec.buy#buy
    .wrap
      .sec-head-row
        div
          .sec-kick.rv
            span.bar
            span.annot Where to buy
          h2.rv data-d="1" Buy from a vendor near you.
          p.sec-lead.rv data-d="2" Order from an authorised Baldrick vendor in your region, or direct from us alongside our trusted partners.
        = link_to "View all vendors →", where_to_buy_baldrick_boards_path, class: "lnk rv", style: "margin-bottom:6px", data: { d: "2" }
      .buy-grid
        - reveal_delays = { 1 => '1', 2 => '2', 4 => '1' }
        - home_buy_regions.each_with_index do |region, index|
          = render 'shared/buy_region_tile', region: region, tile_options: (reveal_delays[index] ? { data: { d: reveal_delays[index] } } : {})

  section.sec.why#why
    .wrap
      .why-head
        .sec-kick.rv
          span.bar
          span.annot Why Baldrick?
        h2.rv data-d="1" Our boards don't just power shows around the world, they power ours
        p.sec-lead.rv data-d="2" No marketing department invented these. Every board comes from a real need on a real display and is built to hold up on the night, every night of the season.

  section.sec.docs#docs
    .wrap
      .sec-head-row
        div
          .sec-kick.rv
            span.bar
            span.annot Explore
          h2.rv data-d="1" More to explore.
        p.sec-lead.rv data-d="2" Everything beyond the boards — guides, downloads and the community that keeps the shows running.
      .ex-grid.rv data-d="1"
        = link_to boards_path, class: "ex-card"
          span.ex-ic
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
              path d="M4 5a2 2 0 0 1 2-2h6v18H6a2 2 0 0 1-2-2zM20 5a2 2 0 0 0-2-2h-6v18h6a2 2 0 0 0 2-2z"
          h3
            | Documentation & Guides
            span.go →
          p Set up, wire and get the most out of every board, step by step.
        = link_to fun_stuff_stls_and_mounts_path, class: "ex-card"
          span.ex-ic
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
              path d="M12 3v12m0 0 4-4m-4 4-4-4"
              path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"
          h3
            | Downloads
            span.go →
          p Free 3D-printable mounts, enclosures and STLs for tidy installs.
        = link_to fun_stuff_customer_showcase_path, class: "ex-card"
          span.ex-ic
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
              rect x="3" y="5" width="18" height="14" rx="2"
              circle cx="8.5" cy="10" r="1.5"
              path d="M21 16l-5-5-4 4-2-2-5 5"
          h3
            | Customer Showcase
            span.go →
          p Real displays from real customers — see what Baldrick boards power in the wild.
        = link_to breakthroughs_cunningfx_path, class: "ex-card"
          span.ex-ic
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
              path d="M13 2 4 14h7l-1 8 9-12h-7z"
          h3
            | CunningFX
            span.go →
          p Advanced effects and animations for displays that like to show off.
        = link_to fun_stuff_release_notes_path, class: "ex-card"
          span.ex-ic
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
              path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              path d="M14 2v6h6M8 13h8M8 17h5"
          h3
            | Release Notes
            span.go →
          p What's new, what changed and what we quietly fixed.
        = link_to support_path, class: "ex-card"
          span.ex-ic
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
              circle cx="9" cy="8" r="3"
              path d="M3 20a6 6 0 0 1 12 0"
              path d="M16 6a3 3 0 0 1 0 6M22 20a6 6 0 0 0-5-5.9"
          h3
            | Community & Support
            span.go →
          p Christmas Triage, active Facebook groups and our Zoom room — help when you need a hand.

