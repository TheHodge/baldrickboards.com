- case_url = triage_case_url(@case.case_number, locale: I18n.locale)
- case_title = "Case ##{@case.case_number} - Christmas Triage - Baldrick Boards"
- case_description = @case.problem_summary.present? ? @case.problem_summary : truncate(@case.problem_description, length: 200)
- og_image_url = nil
- if @case.media.attached?
  - first_image = @case.media.find { |m| m.image? }
  - if first_image
    - og_image_url = rails_blob_url(first_image, only_path: false)
- set_og_data title: case_title, description: case_description, url: case_url, image: og_image_url, type: "article"
- content_for :og_url, case_url

- issue_summary = @case.problem_summary.present? ? @case.problem_summary : truncate(@case.problem_description, length: 150, separator: ' ', omission: '...')
- status_label = @case.open? ? 'Open' : 'Solved'
- opened_meta = @case.created_at.strftime('%b %-d, %Y')
- case_meta = [status_label, "Opened #{opened_meta}"]
- case_meta << @case.affected_boards.join(', ') if @case.affected_boards.present? && @case.affected_boards.any?

= render 'shared/triage_page', page_title: "Case ##{@case.case_number}", current_page: "Case ##{@case.case_number}", parent_page: true, page_subtitle: issue_summary, document_title: "Christmas Triage - Case ##{@case.case_number}", meta: case_meta, wide: true do

  - if flash[:notice].present? && flash[:notice].include?('Case created successfully')
    .triage-banner.is-success
      h3 Case created!
      p You can now use this URL to get help in the Baldrick community or other resources — we've also pinged our team with the information:
      .triage-url-row
        = link_to case_url, case_url, id: 'case-url-link', target: '_blank', data: { url: case_url }
        button#copy-url-btn.btn.btn-line-light.btn-sm type="button" data-url=case_url
          span#copy-btn-text Copy
      = link_to 'https://www.facebook.com/groups/ilightthat', target: '_blank', class: 'btn btn-solid btn-sm' do
        | Visit Baldrick Community
        span.ar →
      p At the bottom of the case we have some possible solutions. If you find a fix, please mark the case as solved and tell us what worked.

  - if can_edit_case?
    .triage-case-actions
      = link_to 'Edit Case', edit_triage_case_path(@case.case_number), class: 'btn btn-line-light btn-sm'
      - if @case.open?
        = link_to 'Mark as Solved', mark_solved_triage_case_path(@case.case_number), class: 'btn btn-solid btn-sm'

  .triage-case
    .triage-case-main
      .triage-panel
        h2 Current Issue
        .body = @case.problem_description

      .triage-panel
        h2 Support Team Updates
        - if @case.case_comments.any?
          .triage-thread
            - @case.case_comments.order(created_at: :desc).each do |comment|
              - team_comment = comment.admin_name == 'Baldrick Team'
              .triage-comment class=('is-team' if team_comment)
                .who
                  b = comment.admin_name
                  time = comment.created_at.strftime('%B %-d, %Y at %I:%M %p')
                .txt = render_comment_content(comment.content)
        - else
          p.triage-empty No updates yet. The support team will reply here.

        - if can_edit_case?
          .triage-reply
            = form_with url: add_comment_triage_case_path(@case.case_number), method: :post, local: true, class: 'triage-form' do |form|
              .triage-field
                = form.label :content, 'Reply to Support Team', class: 'triage-label'
                = form.text_area :content, rows: 4, required: true, placeholder: 'Type your update or reply here...', class: 'triage-input'
              .triage-field
                = form.label :media, 'Add images (optional)', class: 'triage-label'
                = form.file_field :media, multiple: true, accept: 'image/*', class: 'triage-input'
                p.triage-hint You can upload one or more images with your reply.
              .triage-submit
                = form.submit 'Send Reply', class: 'btn btn-solid btn-sm'

      - if @case.solved? && @case.solved_by_solution.present?
        .triage-panel.is-solved
          h2 Solution
          h3.sol-title = @case.solved_by_solution.problem_title
          .body = simple_format(@case.solved_by_solution.solution_text)

      - if @case.solved? && @case.custom_solution.present? && @case.solved_by_solution.blank?
        .triage-panel.is-solved
          h2 Solution
          .body = simple_format(@case.custom_solution)

      - if @case.tried_solutions.present?
        .triage-panel
          h2 What have they tried?
          .body = @case.tried_solutions

      - if @case.media.attached?
        .triage-panel data-controller="image-modal"
          h2 Photos & Media
          .triage-photos
            - @case.media.each do |media|
              - if media.image?
                - thumbnail_variant = media.variant(resize_to_limit: [400, 400])
                .triage-photo data-action="click->image-modal#openModal" data-image-src=blob_url_without_locale(media) data-image-alt=media.filename.to_s
                  = image_tag blob_url_without_locale(thumbnail_variant), alt: media.filename.to_s
                  .cap = media.filename.to_s
              - elsif media.video?
                .triage-photo
                  = video_tag blob_url_without_locale(media), controls: true, preload: 'metadata', playsinline: true
                  .cap = media.filename.to_s

          .triage-modal.hidden data-image-modal-target="modal" data-action="click->image-modal#closeModal"
            .triage-modal-inner
              button.triage-modal-close type="button" data-action="click->image-modal#closeModal" aria-label="Close"
                svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
              img data-image-modal-target="modalImage" alt=""
              .cap data-image-modal-target="modalCaption"

      - if @case.debugging_file.attached?
        .triage-panel
          h2 Baldrick Debugging File
          .triage-file-row
            div
              .name = @case.debugging_file.filename.to_s
              .hint Uploaded with this case
            = link_to 'Open file', blob_url_without_locale(@case.debugging_file), target: '_blank', rel: 'noopener', class: 'btn btn-solid btn-sm'

      - if @case.system_state.present?
        .triage-panel
          h2 Baldrick Board System State
          pre.triage-pre = @case.system_state

      - if @case.fpp_outputs_state.present?
        .triage-panel
          h2 FPP Outputs State
          pre.triage-pre = @case.fpp_outputs_state

      .triage-panel
        h2 Possible Solutions
        .triage-solutions
          .bot
            = image_tag asset_path('chatbotdom.png'), alt: 'ChatBotDom'
          .bubble
            h3 ChatBotDom suggests
            - if @solutions.any?
              - @solutions.each do |solution|
                .triage-sol
                  .copy
                    h4 = solution.problem_title
                    = simple_format(solution.solution_text)
                  - if can_mark_solution_fixed? && @case.open?
                    = form_with url: mark_solution_fixed_triage_case_path(@case.case_number), method: :patch, local: true, data: { turbo_method: :patch } do |form|
                      = form.hidden_field :solution_id, value: solution.id
                      = form.button 'This fixed it!', type: 'submit', class: 'btn btn-ok btn-sm'
            - else
              p.triage-empty I got nothing! Try asking the Baldrick Community.
              = link_to 'https://www.facebook.com/groups/ilightthat', target: '_blank', class: 'btn btn-solid btn-sm empty-cta' do
                | Visit Baldrick Community
                span.ar →

    .triage-case-side
      - if @case.affected_boards.present? && @case.affected_boards.any?
        .triage-panel
          h3 Affected Boards
          .triage-chips
            - @case.affected_boards.each do |board|
              span.triage-chip = board

      .triage-panel
        h3 Case Details
        .triage-dl
          div
            .k Submitted By
            .v = @case.name
          - if @case.knowledge_level.present?
            div
              .k Knowledge Level
              .v = "#{@case.knowledge_level}/10"
              .s = knowledge_level_description(@case.knowledge_level)
          div
            .k Case Opened
            .v = @case.created_at.strftime('%A, %B %-d, %Y')
            .s = @case.created_at.strftime('at %I:%M %p')
          - if @case.solved? || @case.closed?
            div
              .k Case Solved
              .v = @case.updated_at.strftime('%A, %B %-d, %Y')
              .s = @case.updated_at.strftime('at %I:%M %p')

      - if @case.baldrick_version.present? || @case.fpp_version.present? || @case.xlights_version.present? || @case.operating_system.present?
        .triage-panel
          h3 System Information
          .triage-dl
            - if @case.baldrick_version.present?
              div
                .k Baldrick Version
                .v = @case.baldrick_version
            - if @case.fpp_version.present?
              div
                .k FPP Version
                .v = @case.fpp_version
            - if @case.xlights_version.present?
              div
                .k xLights Version
                .v = @case.xlights_version
            - if @case.operating_system.present?
              div
                .k Operating System
                .v = @case.operating_system

- if flash[:notice].present? && flash[:notice].include?('Case created successfully')
  javascript:
    (function() {
      function initCopyButton() {
        var copyBtn = document.getElementById('copy-url-btn');
        var copyBtnText = document.getElementById('copy-btn-text');
        if (copyBtn && !copyBtn.dataset.initialized) {
          copyBtn.dataset.initialized = 'true';
          copyBtn.addEventListener('click', function() {
            var url = copyBtn.getAttribute('data-url');
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(url).then(function() {
                copyBtnText.textContent = 'Copied!';
                setTimeout(function() { copyBtnText.textContent = 'Copy'; }, 2000);
              }).catch(function() {
                copyBtnText.textContent = 'Error';
              });
            } else {
              var textArea = document.createElement('textarea');
              textArea.value = url;
              textArea.style.position = 'fixed';
              textArea.style.opacity = '0';
              document.body.appendChild(textArea);
              textArea.select();
              try {
                document.execCommand('copy');
                copyBtnText.textContent = 'Copied!';
                setTimeout(function() { copyBtnText.textContent = 'Copy'; }, 2000);
              } catch (err) {
                copyBtnText.textContent = 'Error';
              }
              document.body.removeChild(textArea);
            }
          });
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCopyButton);
      } else {
        initCopyButton();
      }
      document.addEventListener('turbo:load', initCopyButton);
    })();
