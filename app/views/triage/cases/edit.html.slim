- content_for :title, "Edit Case ##{@case.case_number} - Christmas Triage"

.max-w-4xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8
  / Breadcrumb Navigation
  = render 'shared/breadcrumbs', breadcrumbs: [{ title: 'Home', path: root_path }, { title: 'Christmas Triage', path: triage_cases_path }, { title: "Case ##{@case.case_number}", path: triage_case_path(@case.case_number) }, { title: 'Edit', path: nil }]

  / Header
  .text-center.mb-8
    h1.text-4xl.font-bold.text-gray-900.mb-2 Edit Case ##{@case.case_number}
    p.text-xl.text-gray-600.mb-2 Update your case information

  / Main Form
  .bg-white.rounded-lg.shadow-lg.overflow-hidden.border.border-gray-200
    .px-8.py-8
      = form_with model: @case, url: triage_case_path(@case.case_number), method: :patch, local: true, multipart: true, class: "space-y-6" do |form|
        - if @case.errors.any?
          .bg-red-50.border.border-red-200.rounded-md.p-4.mb-6
            h3.text-sm.font-medium.text-red-800.mb-2 There were some problems with your submission:
            ul.text-sm.text-red-700.list-disc.list-inside.space-y-1
              - @case.errors.full_messages.each do |message|
                li = message

        / Problem Description
        .space-y-2.pb-6.border-b.border-gray-200
          = form.label :problem_description, "What seems to be the problem", class: "block text-sm font-medium text-gray-700 mb-2"
          p.text-xs.text-gray-500.mb-2 Please be as descriptive as possible - LIGHTS DO NOT WORK is not helpful, but lights on port 5 are showing the wrong colours when FPP is playing does,
          = form.text_area :problem_description, rows: 5, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-purple-500 focus:border-purple-500", required: true, minlength: 10

        / Tried Solutions
        .space-y-2.pb-6.border-b.border-gray-200
          = form.label :tried_solutions, "What have you tried so far?", class: "block text-sm font-medium text-gray-700 mb-2"
          = form.text_area :tried_solutions, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-purple-500 focus:border-purple-500"

        / Affected Boards
        .space-y-2.pb-6.border-b.border-gray-200
          = form.label :affected_boards, "What board / boards does this affect?", class: "block text-sm font-medium text-gray-700 mb-2"
          .grid style="grid-template-columns: repeat(4, 1fr);" class="gap-3"
            - %w[Baldrick8 Baldrick17 BaldrickDMX BaldrickSwitchy BaldrickInput1 BaldrickInput8 BaldrickSignals].each do |board|
              .flex.items-center.p-2.rounded.hover:bg-purple-50.transition-colors
                = form.check_box :affected_boards, { multiple: true, checked: @case.affected_boards&.include?(board), class: "text-purple-600 focus:ring-purple-500" }, board, nil
                = form.label "affected_boards_#{board.downcase}", board, class: "ml-2 text-sm text-gray-700 cursor-pointer"

        / Version Information
        .grid.md:grid-cols-2.gap-4.pb-6.border-b.border-gray-200
          div
            = form.label :baldrick_version, "Baldrick Firmware Version", class: "block text-sm font-medium text-gray-700 mb-2"
            = form.text_field :baldrick_version, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-purple-500 focus:border-purple-500"
          
          div
            = form.label :xlights_version, "xLights Version (If Relevant)", class: "block text-sm font-medium text-gray-700 mb-2"
            = form.text_field :xlights_version, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-purple-500 focus:border-purple-500"
          
          div
            = form.label :fpp_version, "FPP Version (If Relevant)", class: "block text-sm font-medium text-gray-700 mb-2"
            = form.text_field :fpp_version, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-purple-500 focus:border-purple-500"
          
          div
            = form.label :operating_system, "OS", class: "block text-sm font-medium text-gray-700 mb-2"
            = form.text_field :operating_system, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-purple-500 focus:border-purple-500"

        / Knowledge Level
        .space-y-2.pb-6.border-b.border-gray-200
          = form.label :knowledge_level, "Knowledge Level", class: "block text-sm font-medium text-gray-700 mb-2"
          = form.select :knowledge_level, options_for_select((1..10).map { |i| ["#{i}/10 - #{knowledge_level_description(i)}", i] }, @case.knowledge_level), { prompt: "Select your knowledge level...", include_blank: true }, { class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-purple-500 focus:border-purple-500" }

        / Additional Information (Optional)
        .mt-6.space-y-6
          / Baldrick debugging file
          .grid.md:grid-cols-2.gap-6.items-start
            div
              = form.label :debugging_file, "Baldrick debugging file", class: "block text-sm font-medium text-gray-700 mb-2 font-bold"
              p.text-sm.text-gray-600 Download the debugging file from the Help > Debugging Info link on your board and upload it here to replace the current one.
              - if @case.debugging_file.attached?
                p.text-xs.text-gray-500.mt-2 Current file: #{@case.debugging_file.filename}
            div
              = form.file_field :debugging_file, accept: ".json,application/json,text/plain", class: "block w-full text-sm text-gray-700 file:mr-4 file:rounded-md file:border-0 file:bg-purple-600 file:px-4 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-purple-700"
              p.text-xs.text-gray-500.mt-2 Accepts `.json` or text files up to 10MB.

          / xLights show folder
          .grid.md:grid-cols-2.gap-6.items-start
            div
              = form.label :xlights_show_folder, "ZIPPED xLights show folder", class: "block text-sm font-medium text-gray-700 mb-2 font-bold"
              p.text-sm.text-gray-600 Zip the show folder only (max 100MB). Do not include sequences. We extract ILightThat controller settings and matching props.
              - if @case.xlights_show_folder.attached?
                p.text-xs.text-gray-500.mt-2 Current file: #{@case.xlights_show_folder.filename}
            div
              = form.file_field :xlights_show_folder, accept: ".zip,application/zip,application/x-zip-compressed", class: "block w-full text-sm text-gray-700 file:mr-4 file:rounded-md file:border-0 file:bg-purple-600 file:px-4 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-purple-700"
              p.text-xs.text-gray-500.mt-2 Accepts a `.zip` up to 100MB. Do not include sequences.

        / Submit Buttons
        .pt-8.mt-6.flex.justify-between.items-center
          = link_to "Cancel", triage_case_path(@case.case_number), class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50"
          = form.submit "Save Changes", class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors"
