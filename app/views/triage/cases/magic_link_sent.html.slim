- content_for :title, "Magic Link Sent - Christmas Triage"

.max-w-2xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8
  / Breadcrumb Navigation
  = render 'shared/breadcrumbs', breadcrumbs: [{ title: 'Home', path: root_path }, { title: 'Christmas Triage', path: triage_cases_path }, { title: 'Magic Link Sent', path: nil }]

  .bg-white.rounded-lg.shadow-lg.border.border-gray-200.overflow-hidden
    .bg-gradient-to-r.from-purple-50.to-indigo-50.px-8.py-6.border-b.border-purple-200
      .flex.items-center.justify-center.mb-4
        .w-16.h-16.bg-purple-600.rounded-full.flex.items-center.justify-center
          svg.w-8.h-8.text-white fill="none" stroke="currentColor" viewBox="0 0 24 24"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
      h1.text-2xl.font-bold.text-gray-900.text-center Magic Link Sent!
    
    .px-8.py-8
      .text-center.mb-6
        p.text-lg.text-gray-700.mb-4
          | We've sent a magic link to:
        p.text-xl.font-semibold.text-purple-600.mb-6 = @email
        
        p.text-gray-600.mb-6
          | Please check your email and click the link to log in and view your cases.
        
        .bg-blue-50.border.border-blue-200.rounded-lg.p-4.mb-6
          .flex.items-start
            svg.w-5.h-5.text-blue-600.mr-3.mt-0.5 fill="none" stroke="currentColor" viewBox="0 0 24 24"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            div
              p.text-sm.font-medium.text-blue-900.mb-1 Important:
              ul.text-sm.text-blue-800.list-disc.list-inside.space-y-1
                li The magic link will expire in 1 hour
                li Check your spam folder if you don't see the email
                li The link will take you directly to your cases
        
        .flex.flex-col.sm:flex-row.gap-4.justify-center
          = link_to "Back to All Cases", triage_cases_path, class: "inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-base font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors"
          = link_to "Create New Case", new_triage_case_path, class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors"
