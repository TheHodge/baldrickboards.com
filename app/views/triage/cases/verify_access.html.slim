- content_for :title, "Verify Access - Case ##{@case.case_number}"

.max-w-md.mx-auto.px-4.sm:px-6.lg:px-8.py-8
  .bg-white.rounded-lg.shadow-lg.border-2.border-black.overflow-hidden
    .px-8.py-8
      .text-center.mb-6
        h1.text-3xl.font-bold.text-gray-900.mb-2 Christmas Triage
        h2.text-xl.text-gray-600 Case ##{@case.case_number}
        p.text-sm.text-gray-500.mt-4 Please enter the access code sent to your email

      = form_with url: verify_access_triage_case_path(@case.case_number), method: :post, local: true, class: "space-y-6" do |form|
        - if flash[:alert]
          .bg-red-50.border.border-red-200.rounded-md.p-4.mb-6
            p.text-sm.text-red-800 = flash[:alert]

        .space-y-2
          = form.label :access_code, "Access Code", class: "block text-sm font-medium text-gray-700"
          = form.text_field :access_code, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-center text-2xl tracking-widest", placeholder: "000000", maxlength: 6, required: true, autofocus: true

        .flex.justify-center
          = form.submit "Verify Access", class: "px-8 py-3 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 text-lg font-medium"

      .mt-6.text-center
        p.text-sm.text-gray-600
          | Didn't receive the code? Check your spam folder or
          = link_to " create a new case", new_triage_case_path, class: "text-indigo-600 underline hover:text-indigo-800"

