= render 'shared/triage_page', page_title: 'Christmas Triage', current_page: 'New case', parent_page: true, page_subtitle: "Let's get you back up and running as quick as possible", document_title: 'Christmas Triage - Baldrick Boards' do
  p.lead Filling in this form will give you a URL to share and some possible solutions.

  .triage-form-panel
    = form_with model: @case, url: triage_cases_path, local: true, multipart: true, class: 'triage-form', data: { has_errors: @case.errors.any? } do |form|
      - if @case.errors.any?
        .triage-errors data-validation-errors="true"
          h3 There were some problems with your submission:
          ul
            - @case.errors.full_messages.each do |message|
              li = message

      .triage-section
        - unless triage_user_logged_in?
          .triage-field
            = form.label :name, 'Your name', class: 'triage-label'
            = form.text_field :name, class: 'triage-input', required: true, minlength: 2, maxlength: 100

        - if triage_user_logged_in?
          = form.hidden_field :name, value: @case.name
          = form.hidden_field :email, value: @case.email
        - else
          .triage-field
            = form.label :email, 'Your Email', class: 'triage-label'
            p.triage-hint So we can send you updates and you can edit / mark as solved
            = form.email_field :email, class: 'triage-input', required: true

        .triage-field
          = form.label :debugging_file, 'Baldrick debugging file', class: 'triage-label'
          p.triage-hint Download the debugging file from the Help > Debugging Info link on your board, then upload it here. This is one of the most useful things you can send us.
          .triage-media-grid
            div
              = form.file_field :debugging_file, accept: '.json,application/json,text/plain', class: 'triage-input'
              p.triage-hint Accepts `.json` or text files up to 10MB.
            .triage-media-help
              p.triage-hint
                strong Where to find it
                | : scroll to the bottom of the board screen and look in the Help section.
              = image_tag asset_path('triage-debugging-help.png'), alt: 'Screenshot showing the Help section and Debugging Info link'
              p.triage-hint Click `Debugging Info`, save the downloaded file, then upload it here with your case.

        .triage-field
          = form.label :problem_description, 'What seems to be the problem', class: 'triage-label'
          p.triage-hint Please be as descriptive as possible. LIGHTS DO NOT WORK is not helpful, but lights on port 5 are showing the wrong colours when FPP is playing does.
          = form.text_area :problem_description, rows: 5, class: 'triage-input', required: true, minlength: 10

      .triage-section
        = form.label :affected_boards, 'What board / boards does this affect?', class: 'triage-label'
        .triage-board-grid
          - %w[Baldrick8 Baldrick17 BaldrickDMX BaldrickSwitchy BaldrickInput1 BaldrickInput8 BaldrickSignals].each do |board|
            .triage-check
              = form.check_box :affected_boards, { multiple: true, checked: false }, board, nil
              = form.label "affected_boards_#{board.downcase}", board

      .triage-section
        .triage-field
          .triage-label-row
            = form.label :media, 'Please add some screenshots / videos', class: 'triage-label'
            span#file-count.triage-file-count 0 / 10 files (max 100MB each)
          .triage-media-grid
            .triage-media-help
              p.triage-hint Things that are normally helpful to include:
              ul
                li Baldrick Interface (the Status section and Ports)
                li FPP Outputs page (If Relevant)
                li An example of the issue (flickering or slowness)
            #triage-upload-box.triage-upload
              = form.file_field :media, multiple: true, accept: 'image/*,video/*,.heic,.heif,image/heic,image/heif', class: 'hidden', id: 'media-upload', data: { multiple: true }
              label.triage-upload-inner for="media-upload"
                .triage-upload-icon
                  svg fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                p.triage-upload-cta Drag & drop media here or click to upload
          #media-preview

      .triage-section
        .triage-field
          .triage-label-row
            = form.label :xlights_show_folder, 'ZIPPED xLights show folder', class: 'triage-label'
            span.triage-file-count max 100MB · no sequences
          p.triage-hint Zip the show folder only. Do not include sequences. They make the zip huge and we do not need them. We extract ILightThat controller settings from `xlights_networks.xml` and matching props from `xlights_rgbeffects.xml`.
          #xlights-upload-box.triage-upload.triage-upload--tall
            = form.file_field :xlights_show_folder, accept: '.zip,application/zip,application/x-zip-compressed', class: 'hidden', id: 'xlights-upload'
            label.triage-upload-inner for="xlights-upload"
              .triage-upload-icon
                svg fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
              div
                p.triage-upload-cta Drag & drop a zipped xLights show folder here or click to upload
                p.triage-hint Please do not include sequences.
          #xlights-preview

      .triage-section
        .triage-grid-2
          .triage-field
            = form.label :baldrick_version, 'Baldrick Firmware Version', class: 'triage-label'
            = form.text_field :baldrick_version, class: 'triage-input', required: true
          .triage-field
            = form.label :xlights_version, 'xLights Version (If Relevant)', class: 'triage-label'
            = form.text_field :xlights_version, class: 'triage-input'
          .triage-field
            = form.label :fpp_version, 'FPP Version (If Relevant)', class: 'triage-label'
            = form.text_field :fpp_version, class: 'triage-input'
          .triage-field
            = form.label :operating_system, 'OS', class: 'triage-label'
            = form.text_field :operating_system, value: 'Windows', class: 'triage-input'

      .triage-section
        = form.label :tried_solutions, 'What have you tried so far?', class: 'triage-label'
        = form.text_area :tried_solutions, rows: 4, class: 'triage-input'

      .triage-section
        = form.label :knowledge_level, 'And finally, how would you rate your knowledge level', class: 'triage-label'
        = form.select :knowledge_level, options_for_select((1..10).map { |i| ["#{i}/10 - #{knowledge_level_description(i)}", i] }, @case.knowledge_level), { prompt: 'Select your knowledge level...' }, { class: 'triage-input' }

      .triage-submit
        p This is enough basic information to start with, so you can create a case now.
        = form.submit 'Create a Case', class: 'btn btn-solid'

javascript:
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form[action*="triage_cases"]');
    if (!form) return;

    const validations = {
      'case[name]': { required: true, minLength: 2, maxLength: 100, message: 'Name must be between 2 and 100 characters' },
      'case[email]': { required: true, pattern: /^[^\s@]+@[^\s@]+\.[^\s@]+$/, message: 'Please enter a valid email address' },
      'case[problem_description]': { required: true, minLength: 10, message: 'Problem description must be at least 10 characters' },
      'case[baldrick_version]': { required: true, message: 'Baldrick firmware version is required' }
    };

    function showFieldError(field, message) {
      const existingError = field.parentElement.querySelector('.field-error');
      if (existingError) existingError.remove();
      field.classList.add('is-invalid');
      const errorDiv = document.createElement('div');
      errorDiv.className = 'field-error';
      errorDiv.textContent = message;
      field.parentElement.appendChild(errorDiv);
    }

    function clearFieldError(field) {
      const errorDiv = field.parentElement.querySelector('.field-error');
      if (errorDiv) errorDiv.remove();
      field.classList.remove('is-invalid');
    }

    function validateField(field) {
      const rules = validations[field.name];
      if (!rules) return true;
      const value = field.value.trim();
      if (rules.required && !value) { showFieldError(field, 'This field is required'); return false; }
      if (!value) { clearFieldError(field); return true; }
      if (rules.minLength && value.length < rules.minLength) { showFieldError(field, rules.message || 'Must be at least ' + rules.minLength + ' characters'); return false; }
      if (rules.maxLength && value.length > rules.maxLength) { showFieldError(field, rules.message || 'Must be no more than ' + rules.maxLength + ' characters'); return false; }
      if (rules.pattern && !rules.pattern.test(value)) { showFieldError(field, rules.message || 'Invalid format'); return false; }
      clearFieldError(field);
      return true;
    }

    function validateForm() {
      let isValid = true;
      Object.keys(validations).forEach(function(fieldName) {
        const field = form.querySelector('[name="' + fieldName + '"]');
        if (field && !validateField(field)) isValid = false;
      });
      return isValid;
    }

    Object.keys(validations).forEach(function(fieldName) {
      const field = form.querySelector('[name="' + fieldName + '"]');
      if (field) {
        field.addEventListener('blur', function() { validateField(this); });
        field.addEventListener('input', function() { if (this.value.trim()) validateField(this); });
      }
    });

    form.addEventListener('submit', function(e) {
      if (!validateForm()) {
        e.preventDefault();
        e.stopPropagation();
        const firstError = form.querySelector('.is-invalid');
        if (firstError) {
          firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
          setTimeout(function() { firstError.focus(); }, 300);
        }
        if (!form.querySelector('.validation-error-general')) {
          const errorDiv = document.createElement('div');
          errorDiv.className = 'validation-error-general triage-errors';
          errorDiv.innerHTML = '<h3>Please fix the errors below before submitting.</h3>';
          const formContent = form.querySelector('.triage-form') || form;
          formContent.insertBefore(errorDiv, formContent.firstChild);
        }
        return false;
      }
    });
  });

  (function() {
    const mediaUpload = document.getElementById('media-upload');
    const mediaPreview = document.getElementById('media-preview');
    let selectedFiles = [];
    let isProcessing = false;
    const MAX_FILES = 10;
    const MAX_FILE_SIZE = 100 * 1024 * 1024;

    if (!mediaUpload || !mediaPreview) return;

    function restoreFilesFromStorage() {
      const form = mediaUpload.closest('form');
      const hasErrors = form && (form.dataset.hasErrors === 'true' || document.querySelector('[data-validation-errors="true"]'));
      if (!hasErrors) {
        sessionStorage.removeItem('triage_case_media_files');
        return;
      }
      try {
        const stored = sessionStorage.getItem('triage_case_media_files');
        if (stored) {
          JSON.parse(stored).forEach(function(fileData) {
            addFileToPreviewFromMetadata(fileData.name, fileData.type, fileData.size);
          });
        }
      } catch (e) {
        sessionStorage.removeItem('triage_case_media_files');
      }
    }

    const form = mediaUpload.closest('form');
    if (form) {
      form.addEventListener('submit', function(e) {
        if (selectedFiles.length > MAX_FILES) {
          e.preventDefault();
          alert('Maximum of ' + MAX_FILES + ' files allowed. Please remove some files first.');
          return false;
        }
        const oversizedFiles = selectedFiles.filter(function(f) { return f.file && f.file.size > MAX_FILE_SIZE; });
        if (oversizedFiles.length > 0) {
          e.preventDefault();
          alert('The following files are too large (maximum 100MB per file):\n' + oversizedFiles.map(function(f) { return f.file.name; }).join(', '));
          return false;
        }
        if (selectedFiles.length > 0) {
          sessionStorage.setItem('triage_case_media_files', JSON.stringify(selectedFiles.filter(function(f) { return f.file; }).map(function(f) {
            return { name: f.file.name, type: f.file.type, size: f.file.size };
          })));
        } else {
          sessionStorage.removeItem('triage_case_media_files');
        }
      });
    }

    restoreFilesFromStorage();
    updateFileCount();

    function addFileToPreview(file) {
      const fileId = Date.now() + Math.random();
      const reader = new FileReader();
      reader.onload = function(e) {
        const div = document.createElement('div');
        div.className = 'triage-media-item';
        div.dataset.fileId = fileId;
        let previewContent = '';
        if (file.type.startsWith('image/')) {
          previewContent = '<img src="' + e.target.result + '" alt="' + escapeHtml(file.name) + '" />';
        } else if (file.type.startsWith('video/')) {
          previewContent = '<video src="' + e.target.result + '" controls preload="metadata" muted></video>';
        } else {
          previewContent = '<div style="width:72px;height:72px;background:var(--line-p);border-radius:8px"></div>';
        }
        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.innerHTML = '<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>';
        removeButton.onclick = function() { removeFile(fileId); };
        div.innerHTML = previewContent + '<div class="meta"><p class="name">' + escapeHtml(file.name) + '</p><p class="size">' + formatFileSize(file.size) + '</p></div>';
        div.appendChild(removeButton);
        mediaPreview.appendChild(div);
      };
      reader.readAsDataURL(file);
      selectedFiles.push({ id: fileId, file: file });
      updateFileCount();
    }

    function updateFileCount() {
      const fileCountEl = document.getElementById('file-count');
      if (!fileCountEl) return;
      const count = selectedFiles.length;
      fileCountEl.textContent = count + ' / ' + MAX_FILES + ' files (max 100MB each)';
      fileCountEl.classList.toggle('is-max', count >= MAX_FILES);
    }

    function addFileToPreviewFromMetadata(filename, contentType, size) {
      const fileId = Date.now() + Math.random();
      const div = document.createElement('div');
      div.className = 'triage-media-item is-restored';
      div.dataset.fileId = fileId;
      div.dataset.restored = 'true';
      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.innerHTML = '<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>';
      removeButton.onclick = function() { removeFile(fileId); };
      div.innerHTML = '<div style="width:72px;height:72px;background:var(--line-p);border-radius:8px;flex-shrink:0"></div><div class="meta"><p class="name">' + escapeHtml(filename) + '</p><p class="size">' + formatFileSize(parseInt(size || 0)) + '</p><p class="warn">Please re-select this file</p></div>';
      div.appendChild(removeButton);
      mediaPreview.appendChild(div);
      selectedFiles.push({ id: fileId, file: null, metadata: { name: filename, type: contentType, size: size } });
      updateFileCount();
    }

    function removeFile(fileId) {
      selectedFiles = selectedFiles.filter(function(f) { return f.id !== fileId; });
      const element = document.querySelector('[data-file-id="' + fileId + '"]');
      if (element) element.remove();
      updateFileInput();
      updateFileCount();
    }

    function updateFileInput() {
      if (typeof DataTransfer !== 'undefined' && selectedFiles.length > 0) {
        try {
          const dt = new DataTransfer();
          selectedFiles.forEach(function(f) { if (f.file) dt.items.add(f.file); });
          mediaUpload.removeEventListener('change', handleFileChange, true);
          mediaUpload.files = dt.files;
          setTimeout(function() {
            mediaUpload.addEventListener('change', handleFileChange, true);
            isProcessing = false;
          }, 300);
        } catch (e) {
          isProcessing = false;
        }
      } else {
        isProcessing = false;
      }
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function formatFileSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(2) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
    }

    function handleFileChange(e) {
      if (isProcessing) { e.target.value = ''; return; }
      isProcessing = true;
      const newFiles = Array.from(e.target.files || []);
      if (newFiles.length === 0) { isProcessing = false; return; }
      if (selectedFiles.length >= MAX_FILES) {
        alert('Maximum of ' + MAX_FILES + ' files allowed. Please remove some files first.');
        e.target.value = '';
        isProcessing = false;
        return;
      }
      const filesToAdd = [];
      const errors = [];
      newFiles.forEach(function(file) {
        if (file.size > MAX_FILE_SIZE) { errors.push(file.name + ' is too large (maximum 100MB per file)'); return; }
        if (selectedFiles.length + filesToAdd.length >= MAX_FILES) { errors.push('Maximum of ' + MAX_FILES + ' files allowed'); return; }
        const isDuplicate = selectedFiles.some(function(f) {
          return f.file && f.file.name === file.name && f.file.size === file.size && f.file.lastModified === file.lastModified;
        });
        if (!isDuplicate) filesToAdd.push(file);
      });
      if (errors.length > 0) {
        alert(errors.join('\n'));
        e.target.value = '';
        isProcessing = false;
        return;
      }
      filesToAdd.forEach(function(file) { addFileToPreview(file); });
      if (filesToAdd.length > 0) {
        setTimeout(function() { updateFileInput(); isProcessing = false; }, 200);
      } else {
        e.target.value = '';
        isProcessing = false;
      }
    }

    window.removeFile = removeFile;
    mediaUpload.addEventListener('change', handleFileChange, true);

    const uploadBox = document.getElementById('triage-upload-box');
    if (uploadBox) {
      uploadBox.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.stopPropagation();
        uploadBox.classList.add('is-dragover');
      });
      uploadBox.addEventListener('dragleave', function(e) {
        e.preventDefault();
        e.stopPropagation();
        uploadBox.classList.remove('is-dragover');
      });
      uploadBox.addEventListener('drop', function(e) {
        e.preventDefault();
        e.stopPropagation();
        uploadBox.classList.remove('is-dragover');
        if (isProcessing) return;
        isProcessing = true;
        const files = Array.from(e.dataTransfer.files).filter(function(file) {
          if (file.type.startsWith('image/') || file.type.startsWith('video/')) return true;
          return /\.(heic|heif|heics|heifs)$/i.test(file.name || '');
        });
        if (selectedFiles.length >= MAX_FILES) {
          alert('Maximum of ' + MAX_FILES + ' files allowed. Please remove some files first.');
          isProcessing = false;
          return;
        }
        const filesToAdd = [];
        const errors = [];
        files.forEach(function(file) {
          if (file.size > MAX_FILE_SIZE) { errors.push(file.name + ' is too large (maximum 100MB per file)'); return; }
          if (selectedFiles.length + filesToAdd.length >= MAX_FILES) { errors.push('Maximum of ' + MAX_FILES + ' files allowed'); return; }
          const isDuplicate = selectedFiles.some(function(f) {
            return f.file && f.file.name === file.name && f.file.size === file.size && f.file.lastModified === file.lastModified;
          });
          if (!isDuplicate) filesToAdd.push(file);
        });
        if (errors.length > 0) {
          alert(errors.join('\n'));
          isProcessing = false;
          return;
        }
        filesToAdd.forEach(function(file) { addFileToPreview(file); });
        if (filesToAdd.length > 0) updateFileInput();
        setTimeout(function() { isProcessing = false; }, 100);
      });
    }
  })();

  (function() {
    const zipUpload = document.getElementById('xlights-upload');
    const zipBox = document.getElementById('xlights-upload-box');
    const zipPreview = document.getElementById('xlights-preview');
    const MAX_ZIP_SIZE = 100 * 1024 * 1024;
    if (!zipUpload || !zipBox || !zipPreview) return;

    function isZipFile(file) {
      if (!file) return false;
      if (file.type === 'application/zip' || file.type === 'application/x-zip-compressed' || file.type === 'application/octet-stream') {
        return /\.zip$/i.test(file.name || '') || file.type !== 'application/octet-stream';
      }
      return /\.zip$/i.test(file.name || '');
    }

    function formatFileSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(2) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function setZipFile(file) {
      if (!file) return;
      if (!isZipFile(file)) {
        alert('Please upload a .zip of your xLights show folder. Do not include sequences.');
        zipUpload.value = '';
        return;
      }
      if (file.size > MAX_ZIP_SIZE) {
        alert(file.name + ' is too large (maximum 100MB). Zip the show folder without sequences.');
        zipUpload.value = '';
        return;
      }
      try {
        const dt = new DataTransfer();
        dt.items.add(file);
        zipUpload.files = dt.files;
      } catch (e) {}
      zipPreview.innerHTML = '<div class="triage-media-item"><div class="meta"><p class="name">' + escapeHtml(file.name) + '</p><p class="size">' + formatFileSize(file.size) + '</p></div><button type="button" id="xlights-remove" aria-label="Remove zip"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button></div>';
      const removeBtn = document.getElementById('xlights-remove');
      if (removeBtn) {
        removeBtn.addEventListener('click', function() {
          zipUpload.value = '';
          zipPreview.innerHTML = '';
        });
      }
    }

    zipUpload.addEventListener('change', function() {
      const file = zipUpload.files && zipUpload.files[0];
      if (file) setZipFile(file);
      else zipPreview.innerHTML = '';
    });

    zipBox.addEventListener('dragover', function(e) {
      e.preventDefault();
      e.stopPropagation();
      zipBox.classList.add('is-dragover');
    });
    zipBox.addEventListener('dragleave', function(e) {
      e.preventDefault();
      e.stopPropagation();
      zipBox.classList.remove('is-dragover');
    });
    zipBox.addEventListener('drop', function(e) {
      e.preventDefault();
      e.stopPropagation();
      zipBox.classList.remove('is-dragover');
      const file = Array.from(e.dataTransfer.files).find(isZipFile);
      if (!file) {
        alert('Please drop a .zip of your xLights show folder. Do not include sequences.');
        return;
      }
      setZipFile(file);
    });
  })();
