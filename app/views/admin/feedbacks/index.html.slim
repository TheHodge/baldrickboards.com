- breadcrumbs = [{ name: "Feedback Management" }]

.container.mx-auto.px-4.py-8
  / Breadcrumbs
  = render 'shared/admin_breadcrumbs'
  
  .flex.justify-between.items-center.mb-8
    h1.text-3xl.font-bold.text-gray-900 Feedback Management
    = link_to "Admin Dashboard", admin_root_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-md text-sm font-medium"

  / Statistics Cards
  .grid.grid-cols-1.md:grid-cols-5.gap-6.mb-8
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-gray-900 = @total_feedbacks
      .text-sm.text-gray-600 Total Feedback
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-blue-600 = @new_feedbacks
      .text-sm.text-gray-600 New
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-green-600 = @processed_feedbacks
      .text-sm.text-gray-600 Processed
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-purple-600 = @testimonials
      .text-sm.text-gray-600 Testimonials
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-orange-600 = @showcases
      .text-sm.text-gray-600 Showcases

  / Filters
  .bg-white.p-6.rounded-lg.shadow.mb-6
    = form_with url: admin_feedbacks_path, method: :get, local: true, class: "flex flex-wrap gap-4 items-end" do |form|
      .flex-1.min-w-48
        = form.label :type, "Filter by Type", class: "block text-sm font-medium text-gray-700 mb-1"
        = form.select :type, options_for_select([["All Types", ""], ["Testimonial", "testimonial"], ["Showcase", "showcase"]], params[:type]), {}, { class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" }
      
      .flex-1.min-w-48
        = form.label :status, "Filter by Status", class: "block text-sm font-medium text-gray-700 mb-1"
        = form.select :status, options_for_select([["All Status", ""], ["New", "new"], ["Processed", "processed"]], params[:status]), {}, { class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" }
      
      .flex.gap-2
        = form.submit "Filter", class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium"
        = link_to "Clear", admin_feedbacks_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-md text-sm font-medium"

  / Feedback List
  .bg-white.shadow.rounded-lg.overflow-hidden
    .overflow-x-auto
      table.min-w-full.divide-y.divide-gray-200
        thead.bg-gray-50
          tr
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider ID
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Name
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Type
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Status
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Image
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Submitted
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Actions
        tbody.bg-white.divide-y.divide-gray-200
          - @feedbacks.each do |feedback|
            tr.hover:bg-gray-50
              td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.text-gray-900 = feedback.id
              td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-900 = feedback.name
              td.px-6.py-4.whitespace-nowrap
                span.inline-flex.px-2.py-1.text-xs.font-semibold.rounded-full class="#{feedback.testimonial? ? 'bg-purple-100 text-purple-800' : 'bg-orange-100 text-orange-800'}"
                  = feedback.feedback_type.titleize
              td.px-6.py-4.whitespace-nowrap
                span.inline-flex.px-2.py-1.text-xs.font-semibold.rounded-full class="#{feedback.processed? ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800'}"
                  = feedback.processed? ? 'Processed' : 'New'
              td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500
                - if feedback.image.attached?
                  span.inline-flex.items-center.px-2.py-1.rounded-full.text-xs.font-medium.bg-green-100.text-green-800
                    | Has Image
                - else
                  span.inline-flex.items-center.px-2.py-1.rounded-full.text-xs.font-medium.bg-gray-100.text-gray-800
                    | No Image
              td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500 = feedback.created_at.strftime("%m/%d/%Y")
              td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.space-x-2
                = link_to "View", admin_feedback_path(feedback), class: "text-indigo-600 hover:text-indigo-900"
                - unless feedback.processed?
                  = link_to "Mark Processed", mark_processed_admin_feedback_path(feedback), method: :patch, class: "text-green-600 hover:text-green-900", confirm: "Mark this feedback as processed?"
                = link_to "Delete", admin_feedback_path(feedback), method: :delete, class: "text-red-600 hover:text-red-900", confirm: "Are you sure you want to delete this feedback?"

  / Pagination
  .mt-6.flex.justify-center
    = paginate @feedbacks if @feedbacks.respond_to?(:current_page)
