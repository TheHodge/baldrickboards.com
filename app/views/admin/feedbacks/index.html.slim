= render 'shared/admin_page', page_title: 'Feedback Management', current_page: 'Feedback Management', meta: ['Feedback', 'Submissions'] do
  .admin-stats
    .admin-stat
      .n= @total_feedbacks
      .l Total Feedback
    .admin-stat
      .n.accent= @new_feedbacks
      .l New
    .admin-stat
      .n.ok= @processed_feedbacks
      .l Processed
    .admin-stat
      .n.accent= @testimonials
      .l Testimonials
    .admin-stat
      .n.warn= @showcases
      .l Showcases

  .admin-panel
    = form_with url: admin_feedbacks_path, method: :get, local: true, class: 'admin-filters' do |form|
      .admin-panel-head
        h3 Filters
        .admin-filter-actions
          = link_to 'Clear', admin_feedbacks_path, class: 'btn btn-line-light btn-sm'
          = form.submit 'Filter', class: 'btn btn-solid btn-sm'
      .field
        = form.label :type, 'Filter by Type', class: 'admin-field-label'
        = form.select :type, options_for_select([['All Types', ''], ['Testimonial', 'testimonial'], ['Showcase', 'showcase']], params[:type]), {}, class: 'admin-input'
      .field
        = form.label :status, 'Filter by Status', class: 'admin-field-label'
        = form.select :status, options_for_select([['All Status', ''], ['New', 'new'], ['Processed', 'processed']], params[:status]), {}, class: 'admin-input'

  .admin-panel
    h3 Feedback
    .admin-table-wrap
      table.admin-table
        thead
          tr
            th ID
            th Name
            th Type
            th Status
            th Image
            th Submitted
            th Actions
        tbody
          - @feedbacks.each do |feedback|
            tr
              td= feedback.id
              td= feedback.name
              td
                span.admin-badge class=(feedback.testimonial? ? 'admin-badge--violet' : 'admin-badge--warn')
                  = feedback.feedback_type.titleize
              td
                span.admin-badge class=(feedback.processed? ? 'admin-badge--processed' : 'admin-badge--new')
                  = feedback.processed? ? 'Processed' : 'New'
              td
                - if feedback.image.attached?
                  span.admin-badge.admin-badge--ok Has Image
                - else
                  span.admin-badge.admin-badge--muted No Image
              td= feedback.created_at.strftime('%m/%d/%Y')
              td.actions
                = link_to 'View', admin_feedback_path(feedback), class: 'lnk'
                - unless feedback.processed?
                  = link_to 'Mark Processed', mark_processed_admin_feedback_path(feedback), method: :patch, data: { confirm: 'Mark this feedback as processed?' }, class: 'lnk'
                = link_to 'Delete', admin_feedback_path(feedback), method: :delete, data: { confirm: 'Are you sure you want to delete this feedback?' }, class: 'lnk admin-danger'

  - if @feedbacks.respond_to?(:current_page)
    .admin-filter-actions style="justify-content:center;margin-top:8px"
      = paginate @feedbacks
