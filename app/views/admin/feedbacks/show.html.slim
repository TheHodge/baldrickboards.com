.container.mx-auto.px-4.py-8
  .flex.justify-between.items-center.mb-8
    h1.text-3xl.font-bold.text-gray-900 Feedback Details
    = link_to "Back to List", admin_feedbacks_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-md text-sm font-medium"

  .grid.grid-cols-1.lg:grid-cols-3.gap-8
    / Main Content
    .lg:col-span-2.space-y-6
      / Feedback Details
      .bg-white.p-6.rounded-lg.shadow
        h2.text-xl.font-semibold.text-gray-900.mb-4 Submission Details
        .space-y-4
          .grid.grid-cols-1.md:grid-cols-2.gap-4
            div
              label.text-sm.font-medium.text-gray-500 Name
              p.text-lg.text-gray-900 = @feedback.name
            div
              label.text-sm.font-medium.text-gray-500 Email
              p.text-lg.text-gray-900 = @feedback.email
          .grid.grid-cols-1.md:grid-cols-2.gap-4
            div
              label.text-sm.font-medium.text-gray-500 Type
              span.inline-flex.px-3.py-1.text-sm.font-semibold.rounded-full class="#{@feedback.testimonial? ? 'bg-purple-100 text-purple-800' : 'bg-orange-100 text-orange-800'}"
                = @feedback.feedback_type.titleize
            div
              label.text-sm.font-medium.text-gray-500 Status
              span.inline-flex.px-3.py-1.text-sm.font-semibold.rounded-full class="#{@feedback.processed? ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800'}"
                = @feedback.processed? ? 'Processed' : 'New'
          div
            label.text-sm.font-medium.text-gray-500 Submitted
            p.text-lg.text-gray-900 = @feedback.created_at.strftime("%B %d, %Y at %I:%M %p")
          - if @feedback.processed_at
            div
              label.text-sm.font-medium.text-gray-500 Processed
              p.text-lg.text-gray-900 = @feedback.processed_at.strftime("%B %d, %Y at %I:%M %p")

      / Content
      .bg-white.p-6.rounded-lg.shadow
        h2.text-xl.font-semibold.text-gray-900.mb-4 Content
        .prose.max-w-none
          = simple_format(@feedback.content)

      / Image
      - if @feedback.image.attached?
        .bg-white.p-6.rounded-lg.shadow
          h2.text-xl.font-semibold.text-gray-900.mb-4 Attached Image
          .space-y-4
            = image_tag @feedback.image, class: "max-w-full h-auto rounded-lg shadow-sm"
            .text-sm.text-gray-600
              p
                strong Filename: 
                = @feedback.image.filename
              p
                strong Size: 
                = number_to_human_size(@feedback.image.byte_size)
              p
                strong Content Type: 
                = @feedback.image.content_type

    / Sidebar
    .space-y-6
      / Actions
      .bg-white.p-6.rounded-lg.shadow
        h3.text-lg.font-semibold.text-gray-900.mb-4 Actions
        .space-y-3
          - unless @feedback.processed?
            = link_to "Mark as Processed", mark_processed_admin_feedback_path(@feedback), method: :patch, class: "w-full bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md text-sm font-medium text-center block", confirm: "Mark this feedback as processed?"
          = link_to "Delete Feedback", admin_feedback_path(@feedback), method: :delete, class: "w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium text-center block", confirm: "Are you sure you want to delete this feedback? This action cannot be undone."

      / Contact Info
      .bg-white.p-6.rounded-lg.shadow
        h3.text-lg.font-semibold.text-gray-900.mb-4 Contact Information
        .space-y-2
          p
            strong Name: 
            = @feedback.name
          p
            strong Email: 
            = mail_to @feedback.email, @feedback.email, class: "text-indigo-600 hover:text-indigo-900"
          p
            strong Submitted: 
            = @feedback.created_at.strftime("%m/%d/%Y at %I:%M %p")
