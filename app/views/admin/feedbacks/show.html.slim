= render 'shared/admin_page', page_title: 'Feedback Details', current_page: 'Feedback Details', breadcrumbs: [{ name: 'Feedback Management', path: admin_feedbacks_path }], meta: ['Feedback', 'Detail'] do
  .admin-grid-main
    .admin-stack
      .admin-panel
        h3 Submission Details
        .admin-dl
          .row
            span.k Name
            span.v= @feedback.name
          .row
            span.k Email
            span.v= @feedback.email
          .row
            span.k Type
            span.v
              span.admin-badge class=(@feedback.testimonial? ? 'admin-badge--violet' : 'admin-badge--warn')
                = @feedback.feedback_type.titleize
          .row
            span.k Status
            span.v
              span.admin-badge class=(@feedback.processed? ? 'admin-badge--processed' : 'admin-badge--new')
                = @feedback.processed? ? 'Processed' : 'New'
          .row
            span.k Submitted
            span.v= @feedback.created_at.strftime('%B %d, %Y at %I:%M %p')
          - if @feedback.processed_at
            .row
              span.k Processed
              span.v= @feedback.processed_at.strftime('%B %d, %Y at %I:%M %p')

      .admin-panel
        h3 Content
        .admin-dl
          .row
            span.v.box
              = simple_format(@feedback.content)

      - if @feedback.image.attached?
        .admin-panel
          h3 Attached Image
          = image_tag @feedback.image, style: 'max-width:100%;height:auto;border-radius:8px;margin-bottom:14px'
          .admin-dl
            .row
              span.k Filename
              span.v= @feedback.image.filename
            .row
              span.k Size
              span.v= number_to_human_size(@feedback.image.byte_size)
            .row
              span.k Content Type
              span.v= @feedback.image.content_type

    .admin-stack
      .admin-panel
        h3 Actions
        .admin-actions
          - unless @feedback.processed?
            = link_to 'Mark as Processed', mark_processed_admin_feedback_path(@feedback), method: :patch, data: { confirm: 'Mark this feedback as processed?' }, class: 'btn btn-solid btn-sm'
          = link_to 'Delete Feedback', admin_feedback_path(@feedback), method: :delete, data: { confirm: 'Are you sure you want to delete this feedback? This action cannot be undone.' }, class: 'btn btn-line-light btn-sm admin-danger'

      .admin-panel
        h3 Contact Information
        .admin-dl
          .row
            span.k Name
            span.v= @feedback.name
          .row
            span.k Email
            span.v= mail_to @feedback.email, @feedback.email
          .row
            span.k Submitted
            span.v= @feedback.created_at.strftime('%m/%d/%Y at %I:%M %p')
