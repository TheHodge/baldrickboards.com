- content_for :title, "Newsletter Subscribers - Admin - Baldrick Boards"
- breadcrumbs = [{ name: "Newsletter Subscribers" }]

.max-w-6xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8
  / Breadcrumbs
  = render 'shared/admin_breadcrumbs'
  
  / Header
  .flex.justify-between.items-center.mb-8
    div
      h1.text-3xl.font-bold.text-gray-900 Newsletter Subscribers
      p.text-gray-600 Total subscribers: #{@total_count}
    
    .flex.space-x-4
      = link_to "Admin Dashboard", admin_root_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-md text-sm font-medium"
      = link_to export_csv_admin_newsletter_subscribers_path(format: :csv), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors" do
        svg.w-4.h-4.mr-2 fill="currentColor" viewBox="0 0 20 20"
          path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"
        ' Export CSV
      = link_to "Logout", admin_logout_path, method: :delete,class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors"

  / Subscribers Table
  .bg-white.shadow.overflow-hidden.sm:rounded-md
    - if @subscribers.any?
      table.min-w-full.divide-y.divide-gray-200
        thead.bg-gray-50
          tr
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Email
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Subscribed At
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Created At
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Actions
        tbody.bg-white.divide-y.divide-gray-200
          - @subscribers.each do |subscriber|
            tr
              td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.text-gray-900
                = subscriber.email
              td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500
                = subscriber.subscribed_at&.strftime('%Y-%m-%d %H:%M UTC') || 'N/A'
              td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500
                = subscriber.created_at.strftime('%Y-%m-%d %H:%M UTC')
              td.px-6.py-4.whitespace-nowrap.text-sm.font-medium
                = link_to "Remove", admin_newsletter_subscriber_path(subscriber), 
                  method: :delete,
                  data: { confirm: "Are you sure you want to remove #{subscriber.email} from the newsletter list?" },
                  class: "text-red-600 hover:text-red-900 transition-colors"
    - else
      .text-center.py-12
        .text-gray-500
          svg.mx-auto.h-12.w-12.text-gray-400 fill="none" viewBox="0 0 24 24" stroke="currentColor"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"
          h3.mt-2.text-sm.font-medium.text-gray-900 No subscribers
          p.mt-1.text-sm.text-gray-500 Get started by having users subscribe to your newsletter.

  / Stats
  .mt-8.grid.grid-cols-1.gap-5.sm:grid-cols-3
    .bg-white.overflow-hidden.shadow.rounded-lg
      .p-5
        .flex.items-center
          .flex-shrink-0
            svg.h-6.w-6.text-gray-400 fill="none" viewBox="0 0 24 24" stroke="currentColor"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
          .ml-5.w-0.flex-1
            dl
              dt.text-sm.font-medium.text-gray-500.truncate Total Subscribers
              dd.text-lg.font-medium.text-gray-900 = @total_count
    
    .bg-white.overflow-hidden.shadow.rounded-lg
      .p-5
        .flex.items-center
          .flex-shrink-0
            svg.h-6.w-6.text-gray-400 fill="none" viewBox="0 0 24 24" stroke="currentColor"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
          .ml-5.w-0.flex-1
            dl
              dt.text-sm.font-medium.text-gray-500.truncate Latest Subscriber
              dd.text-lg.font-medium.text-gray-900
                - if @subscribers.any?
                  = @subscribers.first.created_at.strftime('%m/%d/%Y')
                - else
                  | None
    
    .bg-white.overflow-hidden.shadow.rounded-lg
      .p-5
        .flex.items-center
          .flex-shrink-0
            svg.h-6.w-6.text-gray-400 fill="none" viewBox="0 0 24 24" stroke="currentColor"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
          .ml-5.w-0.flex-1
            dl
              dt.text-sm.font-medium.text-gray-500.truncate This Month
              dd.text-lg.font-medium.text-gray-900
                - this_month_count = @subscribers.where(created_at: Date.current.beginning_of_month..Date.current.end_of_month).count
                = this_month_count
