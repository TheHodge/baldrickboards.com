= render 'shared/admin_page', page_title: 'Newsletter Subscribers', current_page: 'Newsletter Subscribers', page_subtitle: "Total subscribers: #{@total_count}", meta: ['Subscribers', 'Export'] do
  .admin-stats
    .admin-stat
      .n.accent= @total_count
      .l Total Subscribers
    .admin-stat
      .n
        - if @subscribers.any?
          = @subscribers.first.created_at.strftime('%m/%d/%Y')
        - else
          | —
      .l Latest Subscriber
    .admin-stat
      - this_month_count = @subscribers.where(created_at: Date.current.beginning_of_month..Date.current.end_of_month).count
      .n= this_month_count
      .l This Month

  .admin-panel
    .admin-panel-head
      h3 Subscribers
      .admin-filter-actions
        = link_to 'Export CSV', export_csv_admin_newsletter_subscribers_path(format: :csv), class: 'btn btn-solid btn-sm'
    - if @subscribers.any?
      .admin-table-wrap
        table.admin-table
          thead
            tr
              th Email
              th Subscribed At
              th Created At
              th Actions
          tbody
            - @subscribers.each do |subscriber|
              tr
                td= subscriber.email
                td= subscriber.subscribed_at&.strftime('%Y-%m-%d %H:%M UTC') || 'N/A'
                td= subscriber.created_at.strftime('%Y-%m-%d %H:%M UTC')
                td.actions
                  = link_to 'Remove', admin_newsletter_subscriber_path(subscriber), method: :delete, data: { confirm: "Are you sure you want to remove #{subscriber.email} from the newsletter list?" }, class: 'lnk admin-danger'
    - else
      .admin-empty
        h3 No subscribers
        p Get started by having users subscribe to your newsletter.
