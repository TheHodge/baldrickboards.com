= render 'shared/admin_page', page_title: '404 Error Logs', current_page: '404 Error Logs', page_subtitle: 'Track and analyze 404 errors to improve your site', meta: ['Errors', '404'] do
  .admin-panel
    .admin-panel-head
      h3 Date Range
      .admin-filter-actions
        = form_with url: clear_all_admin_error_logs_path, method: :delete, local: true, data: { confirm: 'Are you sure? This will delete all error logs.' } do |clear_form|
          = clear_form.submit 'Clear All', class: 'btn btn-line-light btn-sm admin-danger'
    = form_with url: admin_error_logs_path, method: :get, local: true, class: 'admin-filters' do |form|
      .field style="max-width:220px"
        = form.label :date_range, 'Show errors from', class: 'admin-field-label'
        = form.select :date_range, options_for_select([['Last 7 days', '7'], ['Last 30 days', '30'], ['Last 90 days', '90'], ['Last year', '365']], params[:date_range].presence || '30'), {}, class: 'admin-input'
      .admin-filter-actions
        = form.submit 'Update', class: 'btn btn-solid btn-sm', data: { disable_with: 'Update' }

  .admin-stats
    .admin-stat
      .n.danger= number_with_delimiter(@total_404s)
      .l Total 404 Errors
      .h All time errors
    .admin-stat
      .n.warn= number_with_delimiter(@unique_404s)
      .l Unique URLs
      .h Distinct error pages
    .admin-stat
      .n= @error_logs.first&.count || 0
      .l Most Frequent
      .h Highest error count

  .admin-panel
    .admin-panel-head
      h3 404 Error Details
      span.admin-mono style="color:var(--ink-mut)"= "#{@error_logs.count} unique errors"
    - if @error_logs.any?
      .admin-table-wrap
        table.admin-table
          thead
            tr
              th URL
              th Count
              th Referrer
              th Browser
              th Last Seen
              th Actions
          tbody
            - @error_logs.each do |error_log|
              tr
                td= error_log.url
                td
                  span.admin-badge.admin-badge--danger= error_log.count
                td= error_log.domain
                td= error_log.browser
                td= error_log.last_seen.strftime('%m/%d/%Y %H:%M')
                td.actions
                  = link_to 'View', admin_error_log_path(error_log), class: 'lnk'
                  = link_to 'Delete', admin_error_log_path(error_log), method: :delete, data: { confirm: 'Are you sure?' }, class: 'lnk admin-danger'
    - else
      .admin-empty
        p No 404 errors recorded yet

  .admin-grid-2
    .admin-panel
      h3 Top Referrers
      - if @top_referrers.any?
        .admin-list
          - @top_referrers.each do |referrer, count|
            .admin-list-row
              span= referrer.presence || 'Direct / Unknown'
              span.count= count
      - else
        .admin-empty
          p No referrer data available

    .admin-panel
      h3 Top Browsers
      - if @top_browsers.any?
        .admin-list
          - @top_browsers.each do |user_agent, count|
            .admin-list-row
              span= user_agent&.split(' ')&.first(2)&.join(' ') || 'Unknown'
              span.count= count
      - else
        .admin-empty
          p No browser data available
