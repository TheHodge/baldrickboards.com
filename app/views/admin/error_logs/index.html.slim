/ Header
.bg-white.shadow-lg.rounded-xl.mb-12
  .px-8.py-8
    .flex.items-center.justify-between
      div
        h1.text-3xl.font-bold.text-gray-900.mb-2 404 Error Logs
        p.text-base.text-gray-600 Track and analyze 404 errors to improve your site
      .flex.items-center.space-x-4
        form.flex.items-center.space-x-3 action=admin_error_logs_path method="get"
          select.rounded-lg.border-gray-300.shadow-sm.focus:border-indigo-500.focus:ring-indigo-500.text-sm.px-3.py-2 name="date_range" id="date_range"
            option value="7" Last 7 days
            option value="30" selected=("selected" if params[:date_range] == "30") Last 30 days
            option value="90" Last 90 days
            option value="365" Last year
          input type="submit" name="commit" value="Update" class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 text-sm font-medium transition-colors" data-disable-with="Update"
        = link_to "Clear All", clear_all_admin_error_logs_path, method: :delete, confirm: "Are you sure? This will delete all error logs.", class: "bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 text-sm font-medium transition-colors"

/ Summary cards
.grid.grid-cols-1.md:grid-cols-3.gap-8.mb-16
  .bg-white.overflow-hidden.shadow-lg.rounded-xl.border.border-gray-100
    .px-8.py-10
      .flex.items-center
        .flex-shrink-0
          .w-16.h-16.bg-gradient-to-r.from-red-500.to-red-600.rounded-xl.flex.items-center.justify-center.shadow-lg
            svg.w-8.h-8.text-white fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"
        .ml-8.flex-1
          dl
            dt.text-sm.font-semibold.text-gray-600.uppercase.tracking-wide.mb-2 Total 404 Errors
            dd.text-4xl.font-bold.text-gray-900.mb-2 = number_with_delimiter(@total_404s)
            dd.text-sm.text-gray-500 All time errors

  .bg-white.overflow-hidden.shadow-lg.rounded-xl.border.border-gray-100
    .px-8.py-10
      .flex.items-center
        .flex-shrink-0
          .w-16.h-16.bg-gradient-to-r.from-orange-500.to-orange-600.rounded-xl.flex.items-center.justify-center.shadow-lg
            svg.w-8.h-8.text-white fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"
        .ml-8.flex-1
          dl
            dt.text-sm.font-semibold.text-gray-600.uppercase.tracking-wide.mb-2 Unique URLs
            dd.text-4xl.font-bold.text-gray-900.mb-2 = number_with_delimiter(@unique_404s)
            dd.text-sm.text-gray-500 Distinct error pages

  .bg-white.overflow-hidden.shadow-lg.rounded-xl.border.border-gray-100
    .px-8.py-10
      .flex.items-center
        .flex-shrink-0
          .w-16.h-16.bg-gradient-to-r.from-yellow-500.to-yellow-600.rounded-xl.flex.items-center.justify-center.shadow-lg
            svg.w-8.h-8.text-white fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"
        .ml-8.flex-1
          dl
            dt.text-sm.font-semibold.text-gray-600.uppercase.tracking-wide.mb-2 Most Frequent
            dd.text-4xl.font-bold.text-gray-900.mb-2 = @error_logs.first&.count || 0
            dd.text-sm.text-gray-500 Highest error count

/ Main error logs table
.bg-white.overflow-hidden.shadow-lg.rounded-xl.border.border-gray-100.mb-16
  .px-8.py-8
    .flex.items-center.justify-between.mb-8
      h3.text-xl.font-semibold.text-gray-900 404 Error Details
      .text-sm.text-gray-500.font-medium = "#{@error_logs.count} unique errors"
    
    - if @error_logs.any?
      .overflow-x-auto
        table.min-w-full.divide-y.divide-gray-200
          thead.bg-gray-50
            tr
              th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider URL
              th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Count
              th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Referrer
              th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Browser
              th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Last Seen
              th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Actions
          tbody.bg-white.divide-y.divide-gray-200
            - @error_logs.each do |error_log|
              tr.hover:bg-gray-50
                td.px-6.py-4.whitespace-nowrap
                  .text-sm.font-medium.text-gray-900.break-all = error_log.url
                td.px-6.py-4.whitespace-nowrap
                  span.inline-flex.items-center.px-2.5.py-0.5.rounded-full.text-xs.font-medium.bg-red-100.text-red-800 = error_log.count
                td.px-6.py-4.whitespace-nowrap
                  .text-sm.text-gray-500.break-all = error_log.domain
                td.px-6.py-4.whitespace-nowrap
                  .text-sm.text-gray-500 = error_log.browser
                td.px-6.py-4.whitespace-nowrap
                  .text-sm.text-gray-500 = error_log.last_seen.strftime("%m/%d/%Y %H:%M")
                td.px-6.py-4.whitespace-nowrap.text-sm.font-medium
                  = link_to "View", admin_error_log_path(error_log), class: "text-indigo-600 hover:text-indigo-900 mr-3"
                  = link_to "Delete", admin_error_log_path(error_log), method: :delete, confirm: "Are you sure?", class: "text-red-600 hover:text-red-900"
    - else
      .text-center.py-12
        .text-gray-400.mb-4
          svg.w-16.h-16.mx-auto fill="currentColor" viewBox="0 0 20 20"
            path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"
        p.text-gray-500.text-base No 404 errors recorded yet

/ Additional stats
.grid.grid-cols-1.lg:grid-cols-2.gap-8
  / Top referrers
  .bg-white.overflow-hidden.shadow-lg.rounded-xl.border.border-gray-100
    .px-8.py-8
      .flex.items-center.mb-8
        .w-12.h-12.bg-gradient-to-r.from-blue-500.to-blue-600.rounded-lg.flex.items-center.justify-center.mr-4
          svg.w-6.h-6.text-white fill="currentColor" viewBox="0 0 20 20"
            path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd"
        h3.text-lg.font-semibold.text-gray-900 Top Referrers
      - if @top_referrers.any?
        .space-y-3
          - @top_referrers.each do |referrer, count|
            .flex.items-center.justify-between.p-3.rounded-lg.hover:bg-gray-50.transition-colors
              .flex-1.min-w-0.mr-3
                p.text-sm.font-medium.text-gray-900.break-all = referrer.presence || 'Direct / Unknown'
              .flex-shrink-0
                span.inline-flex.items-center.px-2.py-1.rounded-full.text-xs.font-bold.bg-blue-100.text-blue-800 = count
      - else
        .text-center.py-10
          .text-gray-400.mb-3
            svg.w-12.h-12.mx-auto fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"
          p.text-gray-500.text-sm No referrer data available

  / Top browsers
  .bg-white.overflow-hidden.shadow-lg.rounded-xl.border.border-gray-100
    .px-8.py-8
      .flex.items-center.mb-8
        .w-12.h-12.bg-gradient-to-r.from-green-500.to-green-600.rounded-lg.flex.items-center.justify-center.mr-4
          svg.w-6.h-6.text-white fill="currentColor" viewBox="0 0 20 20"
            path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"
        h3.text-lg.font-semibold.text-gray-900 Top Browsers
      - if @top_browsers.any?
        .space-y-3
          - @top_browsers.each do |user_agent, count|
            .flex.items-center.justify-between.p-3.rounded-lg.hover:bg-gray-50.transition-colors
              .flex-1.min-w-0.mr-3
                p.text-sm.font-medium.text-gray-900.break-words = user_agent.split(' ').first(2).join(' ')
              .flex-shrink-0
                span.inline-flex.items-center.px-2.py-1.rounded-full.text-xs.font-bold.bg-green-100.text-green-800 = count
      - else
        .text-center.py-10
          .text-gray-400.mb-3
            svg.w-12.h-12.mx-auto fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"
          p.text-gray-500.text-sm No browser data available
