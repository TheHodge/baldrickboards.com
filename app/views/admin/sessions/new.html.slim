= render 'shared/site_page', page_title: 'Admin Login', current_page: 'Admin Login', page_subtitle: 'Enter the admin password to access the admin area', document_title: 'Admin Login - Baldrick Boards', eye_label: 'Admin' do
  .admin-login.admin-panel
    = form_with url: admin_login_path, local: true do |form|
      .admin-dl
        .row
          = form.label :password, 'Password', class: 'admin-field-label'
          = form.password_field :password, required: true, class: 'admin-input', autofocus: true
      .admin-filter-actions style="margin-top:18px"
        = form.submit 'Login', class: 'btn btn-solid btn-sm'
