- content_for :title, "Admin Login - Baldrick Boards"

.max-w-md.mx-auto.px-4.sm:px-6.lg:px-8.py-8
  .bg-white.rounded-lg.shadow-lg.overflow-hidden
    .px-8.py-8
      .text-center.mb-8
        h2.text-2xl.font-bold.text-gray-900 Admin Login
        p.text-gray-600 Enter the admin password to access the admin area

      = form_with url: admin_login_path, local: true, class: "space-y-6" do |form|
        div
          = form.label :password, "Password", class: "block text-sm font-medium text-gray-700 mb-2"
          = form.password_field :password, 
            required: true,
            class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-purple-500 focus:border-purple-500"

        .flex.items-center.justify-center
          = form.submit "Login", 
            class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors"
