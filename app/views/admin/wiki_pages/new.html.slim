- wiki_breadcrumbs = admin_knowledge_breadcrumbs(mode: :new, wiki_page: @wiki_page)

= render 'shared/admin_page', page_title: 'New knowledge page', current_page: 'New page', document_title: 'New page - Knowledge', breadcrumbs: wiki_breadcrumbs do
  div style="display:grid;grid-template-columns:minmax(260px,1fr) minmax(0,2fr);gap:22px;align-items:start"
    .admin-stack
      = render 'sidebar', current_page: @wiki_page
    .admin-stack
      .admin-panel
        - if @prefilled_missing_wiki_target.present?
          .admin-panel style="margin-bottom:20px;border-color:oklch(0.70 0.13 70/.5);background:oklch(0.70 0.13 70/.08)"
            p style="font-weight:600;margin:0 0 8px" Creating a page for a link that does not exist yet
            p style="margin:0;color:var(--ink-text)"
              | You followed a wiki link to
              code.admin-mono style="margin:0 4px" = "[[#{@prefilled_missing_wiki_target}]]"
              | . The title and parent below were guessed from that text—change them if needed, add your body, then save.
        = render 'form'
