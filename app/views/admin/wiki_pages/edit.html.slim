- wiki_breadcrumbs = admin_knowledge_breadcrumbs(mode: :edit, wiki_page: @wiki_page)

= render 'shared/admin_page', page_title: 'Edit page', current_page: 'Edit', document_title: "Edit #{@wiki_page.title} - Knowledge", breadcrumbs: wiki_breadcrumbs do
  div style="display:grid;grid-template-columns:minmax(260px,1fr) minmax(0,2fr);gap:22px;align-items:start"
    .admin-stack
      = render 'sidebar', current_page: @wiki_page
    .admin-stack
      .admin-panel
        p.admin-mono style="margin:0 0 20px;color:var(--ink-mut)" = @wiki_page.title
        = render 'form'
