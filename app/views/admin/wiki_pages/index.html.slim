- wiki_breadcrumbs = admin_knowledge_breadcrumbs(mode: :index)

= render 'shared/admin_page', page_title: 'Internal knowledge', current_page: 'Knowledge', page_subtitle: 'Shared internal docs for your team', document_title: 'Knowledge - Admin', breadcrumbs: wiki_breadcrumbs, meta: ['Admin only', '/en/admin/knowledge'] do
  div style="display:grid;grid-template-columns:minmax(260px,1fr) minmax(0,2fr);gap:22px;align-items:start"
    .admin-stack
      = render 'sidebar', current_page: nil
    .admin-stack
      .admin-panel
        p style="margin:0 0 20px;color:var(--ink-mut)"
          | Pages are only available under the admin area (
          code.admin-mono = '/en/admin/knowledge'
          | ).
        .admin-actions style="flex-direction:row;flex-wrap:wrap"
          = link_to 'New page', new_admin_wiki_page_path, class: 'btn btn-solid btn-sm'
          = link_to 'Formatting guide', admin_knowledge_formatting_guide_path, class: 'btn btn-line-light btn-sm'
