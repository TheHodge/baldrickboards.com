- wiki_breadcrumbs = admin_knowledge_breadcrumbs(mode: :show, wiki_page: @wiki_page)

- content_for :admin_actions do
  = link_to 'Edit', admin_edit_wiki_page_path(wiki_path: @wiki_page.url_path), class: 'btn btn-solid btn-sm'
  = link_to 'Create subpage', new_admin_wiki_page_path(parent_id: @wiki_page.id), class: 'btn btn-line-light btn-sm'

= render 'shared/admin_page', page_title: @wiki_page.title, current_page: @wiki_page.title, document_title: "#{@wiki_page.title} - Knowledge", breadcrumbs: wiki_breadcrumbs do
  div style="display:grid;grid-template-columns:minmax(260px,1fr) minmax(0,2fr);gap:22px;align-items:start"
    .admin-stack
      = render 'sidebar', current_page: @wiki_page
    .admin-stack
      .admin-panel
        .admin-dl style="margin-bottom:20px"
          .row
            .k Wiki link
            .v.box.admin-mono
              | [[#{@wiki_page.url_path}]]
        - if @wiki_page.body.to_plain_text.strip.blank?
          .admin-empty
            p This page has no content yet. Use Edit to add text and attachments.
        - else
          .prose
            == render_wiki_page_body(@wiki_page)
