- content_for :title, "#{@wiki_page.title} - Knowledge"

.flex.max-w-7xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8.gap-8
  = render "sidebar", current_page: @wiki_page
  .flex-1.min-w-0
    .bg-white.rounded-xl.shadow.border.border-gray-100.overflow-hidden
      .px-6.py-4.border-b.border-gray-100.flex.flex-wrap.items-center.justify-between.gap-3
        div
          h1.text-2xl.font-bold.text-gray-900 = @wiki_page.title
          p.text-xs.text-gray-500.mt-1 Slug: #{@wiki_page.slug}
        .flex.gap-2
          = link_to "Edit", edit_admin_wiki_page_path(@wiki_page), class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700"
          = link_to "All pages", admin_wiki_pages_path, class: "px-4 py-2 border border-gray-300 text-sm text-gray-700 rounded-md hover:bg-gray-50"
      .px-6.py-8.max-w-3xl
        - if @wiki_page.body.to_plain_text.strip.blank?
          p.text-gray-500 This page has no content yet. Use Edit to add text and attachments.
        - else
          .prose.max-w-none
            == @wiki_page.body
