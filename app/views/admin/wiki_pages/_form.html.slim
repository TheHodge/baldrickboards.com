- form_url = @wiki_page.new_record? ? admin_wiki_pages_path : admin_wiki_page_path(wiki_path: @wiki_page.url_path)
= form_with model: [:admin, @wiki_page], url: form_url, local: true do |form|
  - if @wiki_page.errors.any?
    .admin-panel style="margin-bottom:20px;border-color:oklch(0.58 0.22 25/.5);background:oklch(0.58 0.22 25/.08)"
      h3 style="margin:0 0 8px;font-size:15px" Please fix the following:
      ul style="margin:0;padding-left:1.25rem;color:var(--ink-text)"
        - @wiki_page.errors.full_messages.each do |message|
          li = message

  .admin-dl
    .row
      = form.label :title, class: 'admin-field-label'
      = form.text_field :title, class: 'admin-input', placeholder: 'Page title'

    .row
      = form.label :parent_id, 'Parent page', class: 'admin-field-label'
      = form.select :parent_id, options_for_select([['Top level', '']] + @wiki_page.parent_select_options, @wiki_page.parent_id), {}, class: 'admin-input'

    .row
      = form.label :position, class: 'admin-field-label'
      p style="font-size:12px;color:var(--ink-mut);margin:0 0 6px" Lower numbers appear first among siblings.
      = form.number_field :position, class: 'admin-input', style: 'max-width:240px'

    .row
      = form.label :body, 'Content', class: 'admin-field-label'
      p style="font-size:13px;color:var(--ink-mut);margin:0 0 8px"
        | Link to another page with wiki-style markers (no full URL needed):
        code.admin-mono style="margin:0 4px"
          | [[page-slug]]
        | ,
        code.admin-mono style="margin:0 4px"
          | [[parent/child]]
        | ,
        code.admin-mono style="margin:0 4px"
          | [[Page title]]
        | , or
        code.admin-mono style="margin:0 4px"
          | [[slug|Custom label]]
        | . The page header shows a ready-made wiki link snippet.
        = link_to 'Full formatting guide', admin_knowledge_formatting_guide_path, class: 'lnk'
        | .
      div style="max-width:48rem;border:1.5px solid var(--line-p);border-radius:8px;overflow:hidden;background:var(--paper-2)"
        = form.rich_text_area :body, class: 'wiki-trix'

  .admin-filter-actions style="margin-top:24px;justify-content:space-between;width:100%"
    div
      - unless @wiki_page.new_record?
        = link_to 'Delete page', admin_wiki_page_path(wiki_path: @wiki_page.url_path), method: :delete, class: 'lnk admin-danger', data: { confirm: 'Delete this page? Child pages become top-level.' }
    div style="display:flex;gap:8px;flex-wrap:wrap"
      = link_to 'Cancel', (@wiki_page.new_record? ? admin_wiki_pages_path : admin_wiki_page_path(wiki_path: @wiki_page.url_path)), class: 'btn btn-line-light btn-sm'
      = form.submit (@wiki_page.new_record? ? 'Create page' : 'Save changes'), class: 'btn btn-solid btn-sm'
