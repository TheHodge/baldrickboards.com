- form_url = @wiki_page.new_record? ? admin_wiki_pages_path : admin_wiki_page_path(@wiki_page)
= form_with model: [:admin, @wiki_page], url: form_url, local: true, class: "space-y-6" do |form|
  - if @wiki_page.errors.any?
    .bg-red-50.border.border-red-200.rounded-md.p-4
      h3.text-sm.font-medium.text-red-800.mb-2 Please fix the following:
      ul.text-sm.text-red-700.list-disc.list-inside
        - @wiki_page.errors.full_messages.each do |message|
          li = message

  .space-y-4
    div
      = form.label :title, class: "block text-sm font-medium text-gray-700 mb-1"
      = form.text_field :title, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500", placeholder: "Page title"

    div
      = form.label :parent_id, "Parent page", class: "block text-sm font-medium text-gray-700 mb-1"
      = form.select :parent_id, options_for_select([["Top level", ""]] + @wiki_page.parent_select_options, @wiki_page.parent_id), {}, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"

    div
      = form.label :position, class: "block text-sm font-medium text-gray-700 mb-1"
      p.text-xs.text-gray-500.mb-1 Lower numbers appear first among siblings.
      = form.number_field :position, class: "w-full max-w-xs px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"

    div
      = form.label :body, "Content", class: "block text-sm font-medium text-gray-700 mb-1"
      .max-w-3xl.border.border-gray-200.rounded-lg.overflow-hidden.bg-white.shadow-sm
        = form.rich_text_area :body, class: "wiki-trix block min-h-[20rem]"

  .flex.justify-between.items-center.flex-wrap.gap-3
    div
      - unless @wiki_page.new_record?
        = link_to "Delete page", admin_wiki_page_path(@wiki_page), method: :delete, class: "text-sm text-red-600 hover:text-red-800", data: { confirm: "Delete this page? Child pages become top-level." }
    .flex.space-x-3
      = link_to "Cancel", (@wiki_page.new_record? ? admin_wiki_pages_path : admin_wiki_page_path(@wiki_page)), class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50"
      = form.submit (@wiki_page.new_record? ? "Create page" : "Save changes"), class: "px-6 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700"
