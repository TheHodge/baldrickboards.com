= render 'shared/admin_page', page_title: 'Search Analytics', current_page: 'Search Analytics', page_subtitle: 'Track on-site search queries and result clicks', meta: ['Search', 'Analytics'] do
  .admin-stats
    .admin-stat
      .n.accent= @total_searches
      .l Total Searches
    .admin-stat
      .n.ok= @total_clicks
      .l Total Clicks
    .admin-stat
      .n.accent= @recent_searches
      .l Recent Searches (7 days)
    .admin-stat
      .n.warn= @recent_clicks
      .l Recent Clicks (7 days)

  .admin-grid-2
    .admin-panel
      h3 Top Search Queries
      - if @top_queries.any?
        .admin-list
          - @top_queries.each do |query, count|
            .admin-list-row
              span= query
              span.count= count
      - else
        .admin-empty
          p No search data available yet.

    .admin-panel
      h3 Top Clicked Results
      - if @top_clicks.any?
        .admin-list
          - @top_clicks.each do |(url, title), count|
            .admin-list-row
              span
                = title || url
                - if title.present?
                  br
                  span.admin-mono style="font-size:11px;color:var(--ink-mut)"= url
              span.count= count
      - else
        .admin-empty
          p No click data available yet.

  .admin-panel
    h3 Recent Search Activity
    - if @search_logs.any?
      .admin-table-wrap
        table.admin-table
          thead
            tr
              th Time
              th Query
              th Type
              th Result
              th IP
          tbody
            - @search_logs.each do |log|
              tr
                td= log.created_at.strftime('%Y-%m-%d %H:%M:%S')
                td= log.query
                td
                  - if log.clicked?
                    span.admin-badge.admin-badge--ok Click
                  - else
                    span.admin-badge.admin-badge--info Search
                td
                  - if log.clicked? && log.result_title.present?
                    = log.result_title
                    br
                    span.admin-mono style="font-size:11px;color:var(--ink-mut)"= log.result_url
                  - else
                    | —
                td= log.ip_address
    - else
      .admin-empty
        p No search activity yet.
