- content_for :admin_actions do
  = form_with url: admin_analytics_path, method: :get, local: true, class: 'admin-filters' do |f|
    .field
      = f.label :date_range, 'Date range', class: 'admin-field-label'
      = f.select :date_range, options_for_select([['Last 7 days', '7'], ['Last 30 days', '30'], ['Last 90 days', '90'], ['Last year', '365']], @date_range), {}, class: 'admin-input'
    .admin-filter-actions
      = f.submit 'Update', class: 'btn btn-solid btn-sm'

= render 'shared/admin_page', page_title: 'Website Analytics', current_page: 'Analytics', page_subtitle: 'Track your website performance and visitor behavior', meta: ["Last #{@date_range} days", "#{number_with_delimiter(@total_visits)} visits"] do
  .admin-stats
    .admin-stat
      .n.accent= number_with_delimiter(@total_visits)
      .l Total visits
      .h Page views in selected period

    .admin-stat
      .n= number_with_delimiter(@total_events)
      .l Total events
      .h All tracked interactions

    .admin-stat
      .n.ok= number_with_delimiter(@unique_visitors)
      .l Unique visitors
      .h Distinct users

  .admin-panel
    .admin-panel-head
      h2 Hourly visitors (last 48 hours)
      span.admin-badge.admin-badge--muted = "#{@hourly_visits_48h.count} hours"
    - if @hourly_visits_48h.any?
      - max_count = @hourly_visits_48h.max_by { |_, count| count }&.last || 1
      div style="overflow-x:auto"
        div style="display:flex;align-items:flex-end;gap:4px;min-height:160px;padding:8px 0"
          - @hourly_visits_48h.each do |hour, count|
            - bar_height = max_count > 0 ? [(count.to_f / max_count * 120).round, 4].max : 0
            div style="display:flex;flex-direction:column;align-items:center;flex:1;min-width:0"
              div style="width:100%;max-width:32px;background:var(--violet);border-radius:4px 4px 0 0;height:#{bar_height}px;min-height:#{count > 0 ? '4px' : '0'}"
              span style="font-size:11px;color:var(--ink-mut);margin-top:6px;text-align:center" = hour.strftime('%m/%d')
              span style="font-size:10px;color:var(--ink-mut);text-align:center" = hour.strftime('%H:%M')
              span style="font-size:12px;font-weight:600;margin-top:4px" = count
    - else
      .admin-empty
        p No hourly data available for the last 48 hours

  .admin-grid-2
    .admin-panel
      .admin-panel-head
        h2 Visits by day
        span.admin-badge.admin-badge--muted = "#{@visits_by_day.count} days"
      - if @visits_by_day.any?
        - peak = @visits_by_day.max_by { |_, c| c }[1]
        .admin-list
          - @visits_by_day.each do |date, count|
            .admin-list-row style="flex-direction:column;align-items:stretch;gap:8px"
              div style="display:flex;justify-content:space-between;align-items:center;gap:12px;width:100%"
                span = date.strftime('%B %d, %Y')
                span.admin-badge.admin-badge--info = count
              div style="width:100%;background:oklch(0 0 0/.06);border-radius:999px;height:8px;overflow:hidden"
                div style="height:100%;background:var(--violet);border-radius:999px;width:#{peak > 0 ? (count.to_f / peak * 100).round : 0}%"
      - else
        .admin-empty
          p No data available for the selected period

    .admin-panel
      .admin-panel-head
        h2 Top pages
        span.admin-badge.admin-badge--muted = "#{@top_pages.count} pages"
      - if @top_pages.any?
        .admin-list
          - @top_pages.each_with_index do |(url, count), index|
            .admin-list-row
              span
                span.admin-badge.admin-badge--muted style="margin-right:8px" = index + 1
                = url.gsub('http://127.0.0.1:3001', '').presence || url
              span.count = count
      - else
        .admin-empty
          p No page views recorded for the selected period

  .admin-grid-2
    .admin-panel
      .admin-panel-head
        h2 Top referrers
      - if @top_referrers.any?
        .admin-list
          - @top_referrers.each do |referrer, count|
            .admin-list-row
              span style="word-break:break-all" = referrer.presence || 'Direct / Unknown'
              span.count = count
      - else
        .admin-empty
          p No referrer data available

    .admin-panel
      .admin-panel-head
        h2 Top browsers
      - if @top_browsers.any?
        .admin-list
          - @top_browsers.each do |user_agent, count|
            .admin-list-row
              span = user_agent.split(' ').first(2).join(' ')
              span.count = count
      - else
        .admin-empty
          p No browser data available

  .admin-panel style="max-width:480px"
    .admin-panel-head
      h2 Top countries
    - if @top_countries.any?
      .admin-list
        - @top_countries.each do |country, count|
          .admin-list-row
            span
              = country_flag(country)
              |  
              = country.presence || 'Unknown'
            span.count = count
    - else
      .admin-empty
        p No country data available
