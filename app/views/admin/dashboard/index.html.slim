- content_for :title, "Admin Dashboard - Baldrick Boards"

.container.mx-auto.px-4.py-8
  / Header
  .flex.justify-between.items-center.mb-8
    div
      h1.text-3xl.font-bold.text-gray-900 Admin Dashboard
      p.text-gray-600 Welcome to the Baldrick Boards admin area
    
    = link_to "Logout", admin_logout_path, method: :delete, class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium"

  / Statistics Cards
  .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-4.gap-6.mb-8
    .bg-white.p-6.rounded-lg.shadow
      .flex.items-center
        .flex-shrink-0
          .w-8.h-8.bg-blue-500.rounded-md.flex.items-center.justify-center
            svg.w-5.h-5.text-white fill="currentColor" viewBox="0 0 20 20"
              path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
              path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
        .ml-4
          .text-2xl.font-bold.text-gray-900 = @total_newsletter_subscribers
          .text-sm.text-gray-600 Newsletter Subscribers
    
    .bg-white.p-6.rounded-lg.shadow
      .flex.items-center
        .flex-shrink-0
          .w-8.h-8.bg-green-500.rounded-md.flex.items-center.justify-center
            svg.w-5.h-5.text-white fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"
        .ml-4
          .text-2xl.font-bold.text-gray-900 = @total_feedbacks
          .text-sm.text-gray-600 Total Feedback
          - if @new_feedbacks > 0
            .text-xs.text-orange-600 = "#{@new_feedbacks} new"
    
    .bg-white.p-6.rounded-lg.shadow
      .flex.items-center
        .flex-shrink-0
          .w-8.h-8.bg-purple-500.rounded-md.flex.items-center.justify-center
            svg.w-5.h-5.text-white fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"
        .ml-4
          .text-2xl.font-bold.text-gray-900 = @total_searches
          .text-sm.text-gray-600 Total Searches
          .text-xs.text-gray-500 = "#{@recent_searches} this week"
    
    .bg-white.p-6.rounded-lg.shadow
      .flex.items-center
        .flex-shrink-0
          .w-8.h-8.bg-indigo-500.rounded-md.flex.items-center.justify-center
            svg.w-5.h-5.text-white fill="currentColor" viewBox="0 0 20 20"
              path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
        .ml-4
          .text-2xl.font-bold.text-gray-900 System
          .text-sm.text-gray-600 All Systems Operational

  / Navigation Cards
  .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-3.gap-6
    / Newsletter Management
    .bg-white.p-6.rounded-lg.shadow.hover:shadow-lg.transition-shadow
      .flex.items-center.mb-4
        .w-10.h-10.bg-blue-100.rounded-lg.flex.items-center.justify-center.mr-4
          svg.w-6.h-6.text-blue-600 fill="currentColor" viewBox="0 0 20 20"
            path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
            path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
        div
          h3.text-lg.font-semibold.text-gray-900 Newsletter
          p.text-sm.text-gray-600 Manage subscribers
      p.text-sm.text-gray-500.mb-4 View and manage newsletter subscribers, export data, and handle unsubscribes.
      = link_to admin_newsletter_subscribers_path, class: "inline-flex items-center text-blue-600 hover:text-blue-800 font-medium" do
        | View Subscribers
        svg.w-4.h-4.ml-1 fill="currentColor" viewBox="0 0 20 20"
          path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"

    / Feedback Management
    .bg-white.p-6.rounded-lg.shadow.hover:shadow-lg.transition-shadow
      .flex.items-center.mb-4
        .w-10.h-10.bg-green-100.rounded-lg.flex.items-center.justify-center.mr-4
          svg.w-6.h-6.text-green-600 fill="currentColor" viewBox="0 0 20 20"
            path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"
        div
          h3.text-lg.font-semibold.text-gray-900 Feedback
          p.text-sm.text-gray-600 Customer testimonials & showcases
      p.text-sm.text-gray-500.mb-4 Review customer feedback, testimonials, and showcase submissions.
      = link_to admin_feedbacks_path, class: "inline-flex items-center text-green-600 hover:text-green-800 font-medium" do
        | View Feedback
        svg.w-4.h-4.ml-1 fill="currentColor" viewBox="0 0 20 20"
          path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"

    / Search Analytics
    .bg-white.p-6.rounded-lg.shadow.hover:shadow-lg.transition-shadow
      .flex.items-center.mb-4
        .w-10.h-10.bg-purple-100.rounded-lg.flex.items-center.justify-center.mr-4
          svg.w-6.h-6.text-purple-600 fill="currentColor" viewBox="0 0 20 20"
            path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"
        div
          h3.text-lg.font-semibold.text-gray-900 Search Analytics
          p.text-sm.text-gray-600 Search queries & clicks
      p.text-sm.text-gray-500.mb-4 Analyze search behavior, popular queries, and user engagement.
      = link_to admin_search_logs_path, class: "inline-flex items-center text-purple-600 hover:text-purple-800 font-medium" do
        | View Analytics
        svg.w-4.h-4.ml-1 fill="currentColor" viewBox="0 0 20 20"
          path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"
