- content_for :title, "Admin Dashboard - Baldrick Boards"

.container.mx-auto.px-4.py-8
  / Header
  .flex.justify-between.items-center.mb-8
    div
      h1.text-3xl.font-bold.text-gray-900 Admin Dashboard
      p.text-gray-600 Welcome to the Baldrick Boards admin area

  / Statistics Cards
  .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-4.gap-6.mb-8
    = link_to admin_newsletter_subscribers_path, class: "bg-white p-6 rounded-lg shadow hover:shadow-lg transition-shadow cursor-pointer"
      .flex.items-center
        .flex-shrink-0
          .w-8.h-8.bg-blue-500.rounded-md.flex.items-center.justify-center
            svg.w-5.h-5.text-white fill="currentColor" viewBox="0 0 20 20"
              path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
              path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
        .ml-4
          .text-2xl.font-bold.text-gray-900 = @total_newsletter_subscribers
          .text-sm.text-gray-600 Newsletter Subscribers
    
    = link_to admin_feedbacks_path, class: "bg-white p-6 rounded-lg shadow hover:shadow-lg transition-shadow cursor-pointer"
      .flex.items-center
        .flex-shrink-0
          .w-8.h-8.bg-green-500.rounded-md.flex.items-center.justify-center
            svg.w-5.h-5.text-white fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"
        .ml-4
          .text-2xl.font-bold.text-gray-900 = @total_feedbacks
          .text-sm.text-gray-600 Total Feedback
          - if @new_feedbacks > 0
            .text-xs.text-orange-600 = "#{@new_feedbacks} new"
    
    = link_to admin_search_logs_path, class: "bg-white p-6 rounded-lg shadow hover:shadow-lg transition-shadow cursor-pointer"
      .flex.items-center
        .flex-shrink-0
          .w-8.h-8.bg-purple-500.rounded-md.flex.items-center.justify-center
            svg.w-5.h-5.text-white fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"
        .ml-4
          .text-2xl.font-bold.text-gray-900 = @total_searches
          .text-sm.text-gray-600 Total Searches
          .text-xs.text-gray-500 = "#{@recent_searches} this week"
    
    .bg-white.p-6.rounded-lg.shadow
      .flex.items-center
        .flex-shrink-0
          .w-8.h-8.bg-indigo-500.rounded-md.flex.items-center.justify-center
            svg.w-5.h-5.text-white fill="currentColor" viewBox="0 0 20 20"
              path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
        .ml-4
          .text-2xl.font-bold.text-gray-900 System
          .text-sm.text-gray-600 All Systems Operational
