- breadcrumbs = [{ name: "Triage Cases" }]

.container.mx-auto.px-4.py-8
  / Breadcrumbs
  = render 'shared/admin_breadcrumbs'
  
  .flex.justify-between.items-center.mb-8
    h1.text-3xl.font-bold.text-gray-900 Triage Cases
    = link_to "Admin Dashboard", admin_root_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-md text-sm font-medium"

  / Statistics Cards
  .grid.grid-cols-1.md:grid-cols-6.gap-6.mb-8
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-gray-900 = @total_cases
      .text-sm.text-gray-600 Total Cases
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-blue-600 = @open_cases
      .text-sm.text-gray-600 Open
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-green-600 = @solved_cases
      .text-sm.text-gray-600 Solved
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-gray-600 = @closed_cases
      .text-sm.text-gray-600 Closed
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-purple-600 = @new_cases_today
      .text-sm.text-gray-600 New Today
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-red-600 = @spam_cases
      .text-sm.text-gray-600 Spam

  / Filters
  .bg-white.p-6.rounded-lg.shadow.mb-6
    = form_with url: admin_triage_cases_path, method: :get, local: true, class: "flex flex-wrap gap-4 items-end" do |form|
      .flex-1.min-w-48
        = form.label :status, "Filter by Status", class: "block text-sm font-medium text-gray-700 mb-1"
        = form.select :status, options_for_select([["All Status", ""], ["Open", "open"], ["Solved", "solved"], ["Closed", "closed"]], params[:status]), {}, { class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" }
      
      .flex-1.min-w-48
        = form.label :spam, "Filter by Spam", class: "block text-sm font-medium text-gray-700 mb-1"
        = form.select :spam, options_for_select([["All Cases", ""], ["Not Spam", "false"], ["Spam Only", "true"]], params[:spam]), {}, { class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" }
      
      .flex.gap-2
        = form.submit "Filter", class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium"
        = link_to "Clear", admin_triage_cases_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-md text-sm font-medium"

  / Cases List
  .bg-white.shadow.rounded-lg.overflow-hidden
    .overflow-x-auto
      table.min-w-full.divide-y.divide-gray-200
        thead.bg-gray-50
          tr
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Case #
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Name
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Email
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Status
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Boards
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Created
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Actions
        tbody.bg-white.divide-y.divide-gray-200
          - @cases.each do |case_record|
            tr class="#{'bg-red-50' if case_record.spam?} hover:bg-gray-50"
              td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.text-gray-900
                = case_record.case_number
                - if case_record.spam?
                  span.ml-2.inline-flex.px-2.py-0.5.rounded.text-xs.font-semibold.bg-red-100.text-red-800 SPAM
              td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-900 = case_record.name
              td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500 = case_record.email
              td.px-6.py-4.whitespace-nowrap
                span.inline-flex.px-2.py-1.text-xs.font-semibold.rounded-full class="#{case_record.status == 'open' ? 'bg-blue-100 text-blue-800' : case_record.status == 'solved' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}"
                  = case_record.status.titleize
              td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500 = case_record.affected_boards.join(', ')
              td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500 = case_record.created_at.strftime("%m/%d/%Y")
              td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.space-x-2
                = link_to "View", admin_triage_case_path(case_record), class: "text-indigo-600 hover:text-indigo-900"
                = link_to "Delete", admin_triage_case_path(case_record), method: :delete, class: "text-red-600 hover:text-red-900", confirm: "Are you sure you want to delete this case?"
