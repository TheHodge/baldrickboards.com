- public_case_url = triage_case_url(@case.case_number, locale: I18n.default_locale)
- case_meta = ["Case ##{@case.case_number}"]
- case_meta << 'Spam' if @case.spam?
- content_for :admin_actions do
  = link_to 'Back to Cases', admin_triage_cases_path, class: 'btn btn-line-light btn-sm'

= render 'shared/admin_page', page_title: "Case ##{@case.case_number}", current_page: "Case ##{@case.case_number}", page_subtitle: 'Review case details, respond to the user, and manage resolution', breadcrumbs: [{ name: 'Triage Cases', path: admin_triage_cases_path }], meta: case_meta do
  .admin-grid-main
    div
      .admin-panel
        h2 Case Information

        = form_with model: [:admin, @case], url: admin_triage_case_path(@case), local: true do |form|
          - if @case.errors.any?
            .admin-dl
              .row
                .k Errors
                .v.box
                  ul
                    - @case.errors.full_messages.each do |message|
                      li= message

          .admin-dl
            .admin-grid-2
              .row
                = form.label :name, 'Name', class: 'admin-field-label'
                = form.text_field :name, class: 'admin-input'
              .row
                = form.label :email, 'Email', class: 'admin-field-label'
                = form.email_field :email, class: 'admin-input'

            .row
              = form.label :status, 'Status', class: 'admin-field-label'
              = form.select :status, options_for_select([['Open', 'open'], ['Solved', 'solved'], ['Closed', 'closed']], @case.status), {}, class: 'admin-input'

            .admin-grid-2
              .row
                = form.label :baldrick_version, 'Baldrick Version', class: 'admin-field-label'
                = form.text_field :baldrick_version, class: 'admin-input'
              .row
                = form.label :fpp_version, 'FPP Version', class: 'admin-field-label'
                = form.text_field :fpp_version, class: 'admin-input'

            .row
              = form.label :problem_description, 'Problem Description', class: 'admin-field-label'
              = form.text_area :problem_description, rows: 5, class: 'admin-input'

            - if @case.tried_solutions.present?
              .row
                = form.label :tried_solutions, 'What they tried', class: 'admin-field-label'
                = form.text_area :tried_solutions, rows: 4, class: 'admin-input'

          .admin-filter-actions style="margin-top:18px"
            = form.submit 'Update Case', class: 'btn btn-solid btn-sm'

      .admin-panel
        h2 Admin Comments
        p style="font-size:13px;color:var(--ink-mut);margin:-8px 0 16px" Add a comment that will be emailed to the user.

        = form_with url: add_comment_admin_triage_case_path(@case), method: :post, local: true do |form|
          .admin-dl
            .row
              = form.label :admin_name, 'Your Name', class: 'admin-field-label'
              = form.text_field :admin_name, placeholder: 'Admin name', class: 'admin-input', required: true
            .row
              = form.label :content, 'Comment', class: 'admin-field-label'
              = form.text_area :content, rows: 5, placeholder: 'Enter your comment...', class: 'admin-input', required: true

          .admin-filter-actions style="margin-top:18px"
            = form.submit 'Send Comment to User', class: 'btn btn-solid btn-sm'

      - if @case.case_comments.any?
        .admin-panel
          h2 Previous Comments
          .admin-dl
            - @case.case_comments.order(created_at: :desc).each do |comment|
              .row
                .k
                  = comment.admin_name
                  span style="font-weight:400;margin-left:8px" = comment.created_at.strftime('%B %-d, %Y at %I:%M %p')
                .v.box style="white-space:pre-wrap"= comment.content

      .admin-panel
        h2 Force Solution
        p style="font-size:13px;color:var(--ink-mut);margin:-8px 0 16px" As an admin, you can force a solution for this case without user interaction.

        = form_with url: force_solution_admin_triage_case_path(@case), method: :patch, local: true do |form|
          .admin-dl
            .row
              = form.label :solution_id, 'Select a Solution', class: 'admin-field-label'
              = form.select :solution_id, options_from_collection_for_select(@all_solutions, :id, :problem_title, @case.solved_by_solution_id), { prompt: 'Choose a solution...' }, class: 'admin-input'
            .row
              = form.label :custom_solution, 'Or Write Custom Solution', class: 'admin-field-label'
              = form.text_area :custom_solution, rows: 4, placeholder: 'Enter a custom solution...', class: 'admin-input'
              p style="font-size:12px;color:var(--ink-mut);margin:6px 0 0" Leave blank if selecting a solution above

          .admin-filter-actions style="margin-top:18px"
            = form.submit 'Force Solution', class: 'btn btn-solid btn-sm'

      - if @case.media.attached?
        .admin-panel
          h2 Media
          .admin-grid-2
            - @case.media.each do |media|
              - if media.image?
                = image_tag blob_url_without_locale(media), style: 'width:100%;height:192px;object-fit:cover;border-radius:8px;border:1px solid var(--line-p)'
              - elsif media.video?
                = video_tag blob_url_without_locale(media), controls: true, style: 'width:100%;height:192px;border-radius:8px;border:1px solid var(--line-p)'

      - if @case.debugging_file.attached?
        .admin-panel
          h2 Debugging File
          .admin-dl
            .row
              .k Filename
              .v= @case.debugging_file.filename.to_s
            .row
              .k Size
              .v= number_to_human_size(@case.debugging_file.byte_size)
            .row
              .k Download
              .v
                = link_to 'Open / Download debugging file', blob_url_without_locale(@case.debugging_file), target: '_blank', rel: 'noopener', class: 'btn btn-solid btn-sm'

      - if @solutions.any?
        .admin-panel
          h2 Matched Solutions (#{@solutions.count})
          .admin-dl
            - @solutions.each do |solution|
              .row
                .k
                  = solution.problem_title
                  - case_solution = @case.case_solutions.find_by(solution: solution)
                  - if case_solution
                    span style="font-weight:400;margin-left:8px" Match Score: #{case_solution.match_score}
                .v.box
                  = simple_format(solution.solution_text)
                  - if @case.solved_by_solution_id == solution.id
                    span.admin-badge.admin-badge--solved style="margin-top:10px" This solution fixed it!

      - if @case.solved? && (@case.solved_by_solution.present? || @case.custom_solution.present?)
        .admin-panel
          h2 Current Solution
          - if @case.solved_by_solution.present?
            .admin-dl
              .row
                .k= @case.solved_by_solution.problem_title
                .v.box= simple_format(@case.solved_by_solution.solution_text)
          - elsif @case.custom_solution.present?
            .admin-dl
              .row
                .v.box= simple_format(@case.custom_solution)

    .admin-stack
      .admin-panel
        h3 Public shareable link
        p style="font-size:13px;color:var(--ink-mut);margin:-8px 0 12px" Users get this URL after submitting. Copy it to share with the user or community if they lost it.
        .v.box style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px"
          = link_to public_case_url, public_case_url, id: 'admin-triage-case-url-link', target: '_blank', rel: 'noopener', style: 'font-family:var(--mono);font-size:12.5px;word-break:break-all;flex:1'
          button#admin-triage-copy-case-url.btn.btn-line-light.btn-sm.bg-gray-100.text-gray-700 type="button" data-url=public_case_url style="flex-shrink:0"
            svg style="width:16px;height:16px;margin-right:6px" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
            span#admin-triage-copy-case-url-text Copy
        p style="font-size:12px;color:var(--ink-mut);margin:8px 0 0" Uses the site default locale (#{I18n.default_locale}) in the path, matching the usual share link.

      .admin-panel
        h3 Quick Actions
        .admin-actions
          - if @case.spam?
            = button_to 'Unmark as Spam', mark_spam_admin_triage_case_path(@case.id, spam: false), method: :patch, data: { turbo: false }, class: 'btn btn-solid btn-sm'
          - else
            = button_to 'Mark as Spam', mark_spam_admin_triage_case_path(@case.id, spam: true), method: :patch, data: { turbo: false }, class: 'btn btn-line-light btn-sm danger'
          - if @case.open?
            = button_to 'Mark as Solved', update_status_admin_triage_case_path(@case, status: 'solved'), method: :patch, class: 'btn btn-solid btn-sm'
          - if @case.solved?
            = button_to 'Mark as Closed', update_status_admin_triage_case_path(@case, status: 'closed'), method: :patch, class: 'btn btn-line-light btn-sm'
          - if @case.open?
            = button_to 'Mark as Closed', update_status_admin_triage_case_path(@case, status: 'closed'), method: :patch, class: 'btn btn-line-light btn-sm'
          = button_to 'Delete Case', admin_triage_case_path(@case), method: :delete, data: { confirm: 'Are you sure you want to delete this case?' }, class: 'btn btn-line-light btn-sm danger'

      .admin-panel
        h3 Case Details
        .admin-dl
          .row
            .k Case Number
            .v.admin-mono= @case.case_number
          .row
            .k Created
            .v= @case.created_at.strftime('%B %d, %Y at %I:%M %p')
          - if @case.updated_at != @case.created_at
            .row
              .k Last Updated
              .v= @case.updated_at.strftime('%B %d, %Y at %I:%M %p')
          .row
            .k Status
            .v
              - status_badge = case @case.status when 'open' then 'admin-badge--open' when 'solved' then 'admin-badge--solved' else 'admin-badge--closed' end
              span.admin-badge class=status_badge = @case.status.titleize
          - if @case.knowledge_level.present?
            .row
              .k Knowledge Level
              .v= "#{@case.knowledge_level}/10 - #{knowledge_level_description(@case.knowledge_level)}"
          - if @case.affected_boards.any?
            .row
              .k Affected Boards
              .v= @case.affected_boards.join(', ')
          - if @case.baldrick_version.present?
            .row
              .k Baldrick Version
              .v= @case.baldrick_version
          - if @case.fpp_version.present?
            .row
              .k FPP Version
              .v= @case.fpp_version
          - if @case.xlights_version.present?
            .row
              .k xLights Version
              .v= @case.xlights_version
          - if @case.operating_system.present?
            .row
              .k OS
              .v= @case.operating_system
          .row
            .k Todoist Sync
            .v
              - sync_badge = case @case.todoist_sync_status when 'synced' then 'admin-badge--ok' when 'failed' then 'admin-badge--danger' else 'admin-badge--warn' end
              span.admin-badge class=sync_badge = @case.todoist_sync_status.titleize
          - if @case.todoist_task_id.present?
            .row
              .k Todoist Task ID
              .v.admin-mono= @case.todoist_task_id
          - if @case.todoist_sync_error.present?
            .row
              .k Last Sync Error
              .v.admin-mono style="color:oklch(0.52 0.2 25)"= @case.todoist_sync_error

      .admin-panel
        h3 Admin Details
        .admin-dl
          .row
            .k Access Code
            .v.admin-mono= @case.access_code
          .row
            .k Access Token
            .v.admin-mono= @case.access_token
          - if @case.ip_address.present?
            .row
              .k IP Address
              .v.admin-mono= @case.ip_address
          .row
            .k Case URL
            .v
              = link_to public_case_url, public_case_url, target: '_blank', rel: 'noopener'
          - if @case.system_state.present?
            .row
              .k System State
              .v
                details
                  summary style="font-size:12px;color:var(--ink-mut);cursor:pointer" Click to view
                  pre.admin-mono style="margin-top:8px;max-height:192px;overflow:auto;padding:10px;background:var(--paper-2);border:1px solid var(--line-p);border-radius:8px"= @case.system_state
          - if @case.fpp_outputs_state.present?
            .row
              .k FPP Outputs State
              .v
                details
                  summary style="font-size:12px;color:var(--ink-mut);cursor:pointer" Click to view
                  pre.admin-mono style="margin-top:8px;max-height:192px;overflow:auto;padding:10px;background:var(--paper-2);border:1px solid var(--line-p);border-radius:8px"= @case.fpp_outputs_state

script
  | (function() {
  |   function initAdminTriageCopyUrl() {
  |     var copyBtn = document.getElementById('admin-triage-copy-case-url');
  |     var copyBtnText = document.getElementById('admin-triage-copy-case-url-text');
  |     if (copyBtn && copyBtnText && !copyBtn.dataset.initialized) {
  |       copyBtn.dataset.initialized = 'true';
  |       copyBtn.addEventListener('click', function() {
  |         var url = copyBtn.getAttribute('data-url');
  |         function showCopied() {
  |           copyBtnText.textContent = 'Copied!';
  |           copyBtn.classList.remove('bg-gray-100', 'text-gray-700');
  |           copyBtn.classList.add('bg-green-100', 'text-green-700');
  |           setTimeout(function() {
  |             copyBtnText.textContent = 'Copy';
  |             copyBtn.classList.remove('bg-green-100', 'text-green-700');
  |             copyBtn.classList.add('bg-gray-100', 'text-gray-700');
  |           }, 2000);
  |         }
  |         if (navigator.clipboard && navigator.clipboard.writeText) {
  |           navigator.clipboard.writeText(url).then(showCopied).catch(function(err) {
  |             console.error('Failed to copy:', err);
  |             copyBtnText.textContent = 'Error';
  |           });
  |         } else {
  |           var textArea = document.createElement('textarea');
  |           textArea.value = url;
  |           textArea.style.position = 'fixed';
  |           textArea.style.opacity = '0';
  |           document.body.appendChild(textArea);
  |           textArea.select();
  |           try {
  |             document.execCommand('copy');
  |             showCopied();
  |           } catch (err) {
  |             console.error('Fallback copy failed:', err);
  |             copyBtnText.textContent = 'Error';
  |           }
  |           document.body.removeChild(textArea);
  |         }
  |       });
  |     }
  |   }
  |   if (document.readyState === 'loading') {
  |     document.addEventListener('DOMContentLoaded', initAdminTriageCopyUrl);
  |   } else {
  |     initAdminTriageCopyUrl();
  |   }
  |   document.addEventListener('turbo:load', initAdminTriageCopyUrl);
  | })();
