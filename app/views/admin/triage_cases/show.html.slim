- breadcrumbs = [{ name: "Triage Cases", path: admin_triage_cases_path }, { name: "Case ##{@case.case_number}" }]

.container.mx-auto.px-4.py-8
  / Breadcrumbs
  = render 'shared/admin_breadcrumbs'
  
  .flex.justify-between.items-center.mb-8
    h1.text-3xl.font-bold.text-gray-900 Case ##{@case.case_number}
    - if @case.spam?
      span.inline-flex.px-3.py-1.rounded-full.text-sm.font-semibold.bg-red-100.text-red-800.mr-4 SPAM
    = link_to "Back to Cases", admin_triage_cases_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-md text-sm font-medium"

  .grid.md:grid-cols-3.gap-6
    / Main Content
    .md:col-span-2.space-y-6
      / Case Information
      .bg-white.shadow.rounded-lg.p-6
        h2.text-2xl.font-bold.mb-4 Case Information
        
        = form_with model: [:admin, @case], url: admin_triage_case_path(@case), local: true, class: "space-y-4" do |form|
          - if @case.errors.any?
            .bg-red-50.border.border-red-200.rounded-md.p-4.mb-6
              ul.text-sm.text-red-700.list-disc.list-inside
                - @case.errors.full_messages.each do |message|
                  li = message

          .grid.md:grid-cols-2.gap-4
            div
              = form.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-1"
              = form.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md"
            
            div
              = form.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1"
              = form.email_field :email, class: "w-full px-3 py-2 border border-gray-300 rounded-md"
          
          div
            = form.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-1"
            = form.select :status, options_for_select([["Open", "open"], ["Solved", "solved"], ["Closed", "closed"]], @case.status), {}, { class: "w-full px-3 py-2 border border-gray-300 rounded-md" }
          
          div
            = form.label :problem_description, "Problem Description", class: "block text-sm font-medium text-gray-700 mb-1"
            = form.text_area :problem_description, rows: 5, class: "w-full px-3 py-2 border border-gray-300 rounded-md"
          
          - if @case.tried_solutions.present?
            div
              = form.label :tried_solutions, "What they tried", class: "block text-sm font-medium text-gray-700 mb-1"
              = form.text_area :tried_solutions, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-md"
          
          .flex.justify-end
            = form.submit "Update Case", class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md"

      / Force Solution Section
      .bg-white.shadow.rounded-lg.p-6
        h2.text-2xl.font-bold.mb-4 Force Solution
        p.text-sm.text-gray-600.mb-4 As an admin, you can force a solution for this case without user interaction.
        
        = form_with url: force_solution_admin_triage_case_path(@case), method: :patch, local: true, class: "space-y-4" do |form|
          div
            = form.label :solution_id, "Select a Solution", class: "block text-sm font-medium text-gray-700 mb-1"
            = form.select :solution_id, options_from_collection_for_select(@all_solutions, :id, :problem_title, @case.solved_by_solution_id), { prompt: "Choose a solution..." }, { class: "w-full px-3 py-2 border border-gray-300 rounded-md" }
          
          div
            = form.label :custom_solution, "Or Write Custom Solution", class: "block text-sm font-medium text-gray-700 mb-1"
            = form.text_area :custom_solution, rows: 4, placeholder: "Enter a custom solution...", class: "w-full px-3 py-2 border border-gray-300 rounded-md"
            p.text-xs.text-gray-500.mt-1 Leave blank if selecting a solution above
          
          .flex.justify-end
            = form.submit "Force Solution", class: "bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-md"

      / Media
      - if @case.media.attached?
        .bg-white.shadow.rounded-lg.p-6
          h2.text-2xl.font-bold.mb-4 Media
          .grid.grid-cols-3.gap-4
            - @case.media.each do |media|
              - if media.image?
                = image_tag blob_url_without_locale(media), class: "w-full h-48 object-cover rounded"
              - elsif media.video?
                = video_tag blob_url_without_locale(media), controls: true, class: "w-full h-48 rounded"

      / Matched Solutions
      - if @solutions.any?
        .bg-white.shadow.rounded-lg.p-6
          h2.text-2xl.font-bold.mb-4 Matched Solutions (#{@solutions.count})
          .space-y-4
            - @solutions.each do |solution|
              .border.border-gray-200.rounded.p-4
                .flex.justify-between.items-start.mb-2
                  h3.text-lg.font-semibold = solution.problem_title
                  - case_solution = @case.case_solutions.find_by(solution: solution)
                  - if case_solution
                    span.text-sm.text-gray-500 Match Score: #{case_solution.match_score}
                p.text-gray-700 = simple_format(solution.solution_text)
                - if @case.solved_by_solution_id == solution.id
                  span.inline-flex.px-2.py-1.text-xs.font-semibold.rounded-full.bg-green-100.text-green-800
                    | This solution fixed it!

      / Current Solution (if solved)
      - if @case.solved? && (@case.solved_by_solution.present? || @case.custom_solution.present?)
        .bg-white.shadow.rounded-lg.p-6
          h2.text-2xl.font-bold.mb-4 Current Solution
          - if @case.solved_by_solution.present?
            .bg-green-50.border.border-green-200.rounded.p-4
              h3.text-lg.font-semibold.mb-2 = @case.solved_by_solution.problem_title
              p.text-gray-700 = simple_format(@case.solved_by_solution.solution_text)
          - elsif @case.custom_solution.present?
            .bg-blue-50.border.border-blue-200.rounded.p-4
              p.text-gray-700 = simple_format(@case.custom_solution)

    / Sidebar
    .space-y-6
      / Quick Actions
      .bg-white.shadow.rounded-lg.p-6
        h3.text-xl.font-bold.mb-4 Quick Actions
        .space-y-2
          - if @case.spam?
            = button_to "Unmark as Spam", mark_spam_admin_triage_case_path(@case.id, spam: false), method: :patch, data: { turbo: false }, class: "w-full bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md text-sm"
          - else
            = button_to "Mark as Spam", mark_spam_admin_triage_case_path(@case.id, spam: true), method: :patch, data: { turbo: false }, class: "w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm"
          - if @case.open?
            = button_to "Mark as Solved", update_status_admin_triage_case_path(@case, status: 'solved'), method: :patch, class: "w-full bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md text-sm"
          - if @case.solved?
            = button_to "Mark as Closed", update_status_admin_triage_case_path(@case, status: 'closed'), method: :patch, class: "w-full bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-md text-sm"
          - if @case.open?
            = button_to "Mark as Closed", update_status_admin_triage_case_path(@case, status: 'closed'), method: :patch, class: "w-full bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-md text-sm"
          = button_to "Delete Case", admin_triage_case_path(@case), method: :delete, data: { confirm: "Are you sure you want to delete this case?" }, class: "w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm"

      / Case Details
      .bg-white.shadow.rounded-lg.p-6
        h3.text-xl.font-bold.mb-4 Case Details
        .space-y-3.text-sm
          div
            strong Case Number:
            p.font-mono = @case.case_number
          div
            strong Created:
            p = @case.created_at.strftime("%B %d, %Y at %I:%M %p")
          - if @case.updated_at != @case.created_at
            div
              strong Last Updated:
              p = @case.updated_at.strftime("%B %d, %Y at %I:%M %p")
          div
            strong Status:
            p
              span class="px-2 py-1 rounded text-xs font-semibold #{@case.status == 'open' ? 'bg-blue-100 text-blue-800' : @case.status == 'solved' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}"
                = @case.status.titleize
          - if @case.knowledge_level.present?
            div
              strong Knowledge Level:
              p = "#{@case.knowledge_level}/10 - #{knowledge_level_description(@case.knowledge_level)}"
          - if @case.affected_boards.any?
            div
              strong Affected Boards:
              p = @case.affected_boards.join(', ')
          - if @case.baldrick_version.present?
            div
              strong Baldrick Version:
              p = @case.baldrick_version
          - if @case.fpp_version.present?
            div
              strong FPP Version:
              p = @case.fpp_version
          - if @case.xlights_version.present?
            div
              strong xLights Version:
              p = @case.xlights_version
          - if @case.operating_system.present?
            div
              strong OS:
              p = @case.operating_system

      / Admin-Only Details
      .bg-yellow-50.border.border-yellow-200.shadow.rounded-lg.p-6
        h3.text-xl.font-bold.mb-4.text-yellow-900 Admin Details
        .space-y-3.text-sm
          div
            strong Access Code:
            p.font-mono.text-xs = @case.access_code
          div
            strong Access Token:
            p.font-mono.text-xs.break-all = @case.access_token
          - if @case.ip_address.present?
            div
              strong IP Address:
              p.font-mono.text-xs = @case.ip_address
          div
            strong Case URL:
            p.text-xs.break-all
              = link_to triage_case_url(@case.case_number), triage_case_url(@case.case_number), target: "_blank", class: "text-blue-600 hover:text-blue-800"
          - if @case.system_state.present?
            div
              strong System State:
              details
                summary.text-xs.text-gray-600.cursor-pointer Click to view
                pre.text-xs.bg-gray-100.p-2.mt-2.rounded.overflow-auto.max-h-48 = @case.system_state
          - if @case.fpp_outputs_state.present?
            div
              strong FPP Outputs State:
              details
                summary.text-xs.text-gray-600.cursor-pointer Click to view
                pre.text-xs.bg-gray-100.p-2.mt-2.rounded.overflow-auto.max-h-48 = @case.fpp_outputs_state
