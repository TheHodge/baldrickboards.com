- form_url = @solution.new_record? ? admin_triage_solutions_path : admin_triage_solution_path(@solution)
= form_with model: @solution, url: form_url, local: true, class: "space-y-6" do |form|
  - if @solution.errors.any?
    .bg-red-50.border.border-red-200.rounded-md.p-4.mb-6
      h3.text-sm.font-medium.text-red-800.mb-2 There were some problems:
      ul.text-sm.text-red-700.list-disc.list-inside
        - @solution.errors.full_messages.each do |message|
          li = message

  .space-y-4
    div
      = form.label :problem_title, "Problem Title", class: "block text-sm font-medium text-gray-700 mb-1"
      = form.text_field :problem_title, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500", placeholder: "e.g., Wrong pixels lighting up on each port"
    
    div
      = form.label :solution_text, "Solution Text", class: "block text-sm font-medium text-gray-700 mb-1"
      = form.text_area :solution_text, rows: 6, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500", placeholder: "Detailed solution description..."
    
    div
      = form.label :problem_keywords, "Problem Keywords (one per line)", class: "block text-sm font-medium text-gray-700 mb-1"
      p.text-xs.text-gray-500.mb-2 Enter keywords that would match this problem, one per line. These will be used for matching.
      - current_keywords = @solution.problem_keywords.present? ? @solution.problem_keywords.join("\n") : ""
      = form.text_area :problem_keywords, value: current_keywords, rows: 6, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 font-mono text-sm", placeholder: "pixels\nlighting\nwrong\nport"
      p.text-xs.text-gray-500.mt-1 Keywords will be split by newlines
    
    div
      = form.label :board_types, "Board Types (optional)", class: "block text-sm font-medium text-gray-700 mb-1"
      p.text-xs.text-gray-500.mb-2 Select which boards this solution applies to (leave empty for all boards)
      .grid.grid-cols-2.md:grid-cols-4.gap-3
        - %w[Baldrick8 Baldrick17 BaldrickDMX BaldrickSwitchy BaldrickInput1 BaldrickInput8 BaldrickSignals].each do |board|
          .flex.items-center
            = form.check_box :board_types, { multiple: true, checked: @solution.board_types&.include?(board) }, board, nil
            = form.label "board_types_#{board.downcase}", board, class: "ml-2 text-sm text-gray-700"
    
    div
      .flex.items-center
        = form.check_box :active, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
        = form.label :active, "Active (solution will be used for matching)", class: "ml-2 text-sm text-gray-700"

  .flex.justify-end.space-x-4
    = link_to "Cancel", admin_triage_solutions_path, class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50"
    = form.submit "Save Solution", class: "px-6 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700"
