- form_url = @solution.new_record? ? admin_triage_solutions_path : admin_triage_solution_path(@solution)
= form_with model: @solution, url: form_url, local: true do |form|
  - if @solution.errors.any?
    .admin-dl
      .row
        .k Errors
        .v.box
          ul
            - @solution.errors.full_messages.each do |message|
              li= message

  .admin-dl
    .row
      = form.label :problem_title, 'Problem Title', class: 'admin-field-label'
      = form.text_field :problem_title, class: 'admin-input', placeholder: 'e.g., Wrong pixels lighting up on each port'

    .row
      = form.label :solution_text, 'Solution Text', class: 'admin-field-label'
      = form.text_area :solution_text, rows: 6, class: 'admin-input', placeholder: 'Detailed solution description...'

    .row
      = form.label :problem_keywords, 'Problem Keywords (one per line)', class: 'admin-field-label'
      p style="font-size:13px;color:var(--ink-mut);margin:0 0 8px" Enter keywords that would match this problem, one per line. These will be used for matching.
      - current_keywords = @solution.problem_keywords.present? ? @solution.problem_keywords.join("\n") : ''
      = form.text_area :problem_keywords, value: current_keywords, rows: 6, class: 'admin-input admin-mono', placeholder: "pixels\nlighting\nwrong\nport"
      p style="font-size:12px;color:var(--ink-mut);margin:6px 0 0" Keywords will be split by newlines

    .row
      = form.label :board_types, 'Board Types (optional)', class: 'admin-field-label'
      p style="font-size:13px;color:var(--ink-mut);margin:0 0 8px" Select which boards this solution applies to (leave empty for all boards)
      .admin-grid-2
        - %w[Baldrick8 Baldrick17 BaldrickDMX BaldrickSwitchy BaldrickInput1 BaldrickInput8 BaldrickSignals].each do |board|
          label style="display:flex;align-items:center;gap:8px;font-size:14px"
            = form.check_box :board_types, { multiple: true, checked: @solution.board_types&.include?(board) }, board, nil
            = board

    .row
      label style="display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer"
        = form.check_box :active
        span Active (solution will be used for matching)

  .admin-filter-actions style="margin-top:18px"
    = link_to 'Cancel', admin_triage_solutions_path, class: 'btn btn-line-light btn-sm'
    = form.submit 'Save Solution', class: 'btn btn-solid btn-sm'
