- content_for :admin_actions do
  = link_to 'Edit', edit_admin_triage_solution_path(@solution), class: 'btn btn-solid btn-sm'
  = link_to 'Back to Solutions', admin_triage_solutions_path, class: 'btn btn-line-light btn-sm'

= render 'shared/admin_page', page_title: "Solution ##{@solution.id}", current_page: "Solution ##{@solution.id}", page_subtitle: @solution.problem_title, breadcrumbs: [{ name: 'Triage Solutions', path: admin_triage_solutions_path }], meta: ['Support', 'Solutions'] do
  .admin-grid-main
    div
      .admin-panel
        h2 Solution Details
        .admin-dl
          .row
            .k Problem Title
            .v= @solution.problem_title
          .row
            .k Solution
            .v.box= simple_format(@solution.solution_text)
          .row
            .k Keywords
            .v
              - @solution.problem_keywords.each do |keyword|
                span.admin-badge.admin-badge--info style="margin:0 6px 6px 0"= keyword
          - if @solution.board_types.any?
            .row
              .k Board Types
              .v
                - @solution.board_types.each do |board|
                  span.admin-badge.admin-badge--ok style="margin:0 6px 6px 0"= board
          .row
            .k Status
            .v
              span.admin-badge class=(@solution.active? ? 'admin-badge--ok' : 'admin-badge--muted') = @solution.active? ? 'Active' : 'Inactive'

      .admin-panel
        h2 Statistics
        .admin-stats style="margin-bottom:0"
          .admin-stat
            .n= @solution.match_count
            .l Total Matches
          .admin-stat
            .n.ok= @solution.success_count
            .l Successful
          .admin-stat
            .n.accent= "#{@solution.success_rate}%"
            .l Success Rate

    .admin-stack
      - if @cases.any?
        .admin-panel
          h3 Recent Cases (#{@cases.count})
          .admin-dl
            - @cases.each do |case_record|
              .row
                .k
                  = link_to "Case ##{case_record.case_number}", admin_triage_case_path(case_record)
                  - case_solution = case_record.case_solutions.find_by(solution: @solution)
                  - if case_solution
                    span style="font-weight:400;margin-left:8px" Score: #{case_solution.match_score}
                .v
                  = case_record.name
                  - if case_record.solved_by_solution_id == @solution.id
                    span.admin-badge.admin-badge--solved style="margin-left:8px" Fixed!
