- content_for :admin_actions do
  = link_to 'New Solution', new_admin_triage_solution_path, class: 'btn btn-solid btn-sm'

= render 'shared/admin_page', page_title: 'Triage Solutions', current_page: 'Triage Solutions', page_subtitle: 'Manage automated triage solution matching', meta: ['Support', 'Solutions'] do
  .admin-stats
    .admin-stat
      .n= @total_solutions
      .l Total Solutions
    .admin-stat
      .n.ok= @active_solutions
      .l Active
    .admin-stat
      .n= @inactive_solutions
      .l Inactive

  .admin-panel
    = form_with url: admin_triage_solutions_path, method: :get, local: true, class: 'admin-filters' do |form|
      .field
        = form.label :active, 'Status', class: 'admin-field-label'
        = form.select :active, options_for_select([['All', ''], ['Active', 'true'], ['Inactive', 'false']], params[:active]), {}, class: 'admin-input'
      .admin-filter-actions
        = form.submit 'Filter', class: 'btn btn-solid btn-sm'
        = link_to 'Clear', admin_triage_solutions_path, class: 'btn btn-line-light btn-sm'

  .admin-panel
    .admin-table-wrap
      table.admin-table
        thead
          tr
            th ID
            th Problem Title
            th Keywords
            th Status
            th Matches
            th Success
            th Success Rate
            th Actions
        tbody
          - @solutions.each do |solution|
            tr
              td= solution.id
              td= solution.problem_title
              td= solution.problem_keywords.join(', ').truncate(50)
              td
                span.admin-badge class=(solution.active? ? 'admin-badge--ok' : 'admin-badge--muted') = solution.active? ? 'Active' : 'Inactive'
              td= solution.match_count
              td= solution.success_count
              td= "#{solution.success_rate}%"
              td.actions
                = link_to 'View', admin_triage_solution_path(solution)
                = link_to 'Edit', edit_admin_triage_solution_path(solution)
                = link_to 'Delete', admin_triage_solution_path(solution), method: :delete, confirm: 'Are you sure you want to delete this solution?', class: 'lnk admin-danger'
