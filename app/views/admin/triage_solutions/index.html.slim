- breadcrumbs = [{ name: "Triage Solutions" }]

.container.mx-auto.px-4.py-8
  / Breadcrumbs
  = render 'shared/admin_breadcrumbs'
  
  .flex.justify-between.items-center.mb-8
    h1.text-3xl.font-bold.text-gray-900 Triage Solutions
    div.space-x-2
      = link_to "New Solution", new_admin_triage_solution_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium"
      = link_to "Admin Dashboard", admin_root_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-md text-sm font-medium"

  / Statistics Cards
  .grid.grid-cols-1.md:grid-cols-3.gap-6.mb-8
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-gray-900 = @total_solutions
      .text-sm.text-gray-600 Total Solutions
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-green-600 = @active_solutions
      .text-sm.text-gray-600 Active
    .bg-white.p-6.rounded-lg.shadow
      .text-2xl.font-bold.text-gray-600 = @inactive_solutions
      .text-sm.text-gray-600 Inactive

  / Filters
  .bg-white.p-6.rounded-lg.shadow.mb-6
    = form_with url: admin_triage_solutions_path, method: :get, local: true, class: "flex flex-wrap gap-4 items-end" do |form|
      .flex-1.min-w-48
        = form.label :active, "Filter by Status", class: "block text-sm font-medium text-gray-700 mb-1"
        = form.select :active, options_for_select([["All", ""], ["Active", "true"], ["Inactive", "false"]], params[:active]), {}, { class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" }
      
      .flex.gap-2
        = form.submit "Filter", class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium"
        = link_to "Clear", admin_triage_solutions_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-md text-sm font-medium"

  / Solutions List
  .bg-white.shadow.rounded-lg.overflow-hidden
    .overflow-x-auto
      table.min-w-full.divide-y.divide-gray-200
        thead.bg-gray-50
          tr
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider ID
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Problem Title
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Keywords
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Status
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Matches
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Success
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Success Rate
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Actions
        tbody.bg-white.divide-y.divide-gray-200
          - @solutions.each do |solution|
            tr.hover:bg-gray-50
              td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.text-gray-900 = solution.id
              td.px-6.py-4.text-sm.text-gray-900 = solution.problem_title
              td.px-6.py-4.text-sm.text-gray-500 = solution.problem_keywords.join(', ').truncate(50)
              td.px-6.py-4.whitespace-nowrap
                span.inline-flex.px-2.py-1.text-xs.font-semibold.rounded-full class="#{solution.active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}"
                  = solution.active? ? 'Active' : 'Inactive'
              td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500 = solution.match_count
              td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500 = solution.success_count
              td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500 = "#{solution.success_rate}%"
              td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.space-x-2
                = link_to "View", admin_triage_solution_path(solution), class: "text-indigo-600 hover:text-indigo-900"
                = link_to "Edit", edit_admin_triage_solution_path(solution), class: "text-blue-600 hover:text-blue-900"
                = link_to "Delete", admin_triage_solution_path(solution), method: :delete, class: "text-red-600 hover:text-red-900", confirm: "Are you sure you want to delete this solution?"
