- content_for :title, "Unsubscribe from Newsletter - Baldrick Boards"

.max-w-4xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8
  / Breadcrumb
  = render 'shared/breadcrumbs', breadcrumbs: page_breadcrumbs('Home', 'Unsubscribe')

  / Main Content Card
  .bg-white.rounded-lg.shadow-lg.overflow-hidden
    / Header Section
    = render 'shared/page_header', title: 'Newsletter Unsubscribe', subtitle: 'Manage your newsletter subscription'

    / Content Section
    .px-8.py-8
      .max-w-2xl.mx-auto.text-center
        .prose.max-w-none
          - if flash[:notice]
            .bg-green-50.border-l-4.border-green-400.p-4.mb-6
              .flex
                .flex-shrink-0
                  svg.h-5.w-5.text-green-400 viewBox="0 0 20 20" fill="currentColor"
                    path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"
                .ml-3
                  p.text-sm.text-green-700
                    = flash[:notice]

          - if flash[:alert]
            .bg-red-50.border-l-4.border-red-400.p-4.mb-6
              .flex
                .flex-shrink-0
                  svg.h-5.w-5.text-red-400 viewBox="0 0 20 20" fill="currentColor"
                    path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.293l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd"
                .ml-3
                  p.text-sm.text-red-700
                    = flash[:alert]

          - unless flash[:notice] || flash[:alert]
            h2.text-2xl.font-bold.text-gray-900.mb-4
              | Unsubscribe from Newsletter

            p.text-lg.text-gray-700.mb-6
              | We're sorry to see you go! If you change your mind, you can always resubscribe using the form on our homepage.

            .bg-blue-50.border-l-4.border-blue-400.p-4.mb-6
              .flex
                .flex-shrink-0
                  svg.h-5.w-5.text-blue-400 viewBox="0 0 20 20" fill="currentColor"
                    path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"
                .ml-3
                  p.text-sm.text-blue-700
                    strong Note:
                    |  This unsubscribe link was sent to you in a newsletter email. If you didn't request this, please ignore this page.

            .mt-8
              = link_to "Return to Homepage", root_path, class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors"
