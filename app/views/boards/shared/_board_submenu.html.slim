/ Board bar (pinned sub-nav — rendered via content_for :boardbar in layout)
- board_id = local_assigns[:board_id] || board_name.to_s.downcase.gsub(/\s+/, '')
- buy_path = board_page_path(board_id, 'buy-this-board')

.boardbar
  .wrap.boardbar-inner
    span.bb-name
      span.chipdot
      = board_name
    nav.bb-tabs
      - menu_items.each do |item|
        = link_to item[:title], item[:path], class: "bb-tab#{' active' if current_page?(item[:path])}"
    span.bb-sp
    = link_to buy_path, class: "btn btn-green btn-sm bb-buy" do
      svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor"
        path d="M3 1a1 1 0 000 2h1.22l.305 1.222.01.042 1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"
      span.txt Where to Buy
