- content_for :title, "BaldrickInput8 Getting Started - Baldrick Board Documentation"

= render 'boards/shared/content_page', board_id: 'baldrickinput8', page_title: 'Getting Started with BaldrickInput8', current_page: 'Getting Started', page_subtitle: 'Setup and Configuration Guide', document_title: "BaldrickInput8 Getting Started - Baldrick Board Documentation" do
  .prose.max-w-none
    h1.text-4xl.font-bold.text-gray-900.mb-6 Getting Started with BaldrickInput8

    .bg-blue-50.border-l-4.border-blue-400.p-6.mb-8
      .flex
        .flex-shrink-0
          svg.h-8.w-8.text-blue-400 viewBox="0 0 20 20" fill="currentColor"
            path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"
        .ml-4
          h2.text-2xl.font-bold.text-blue-900.mb-2 Yeah, we've not written this yet...
          p.text-blue-700
            | For now you can checkout the #{link_to "getting started guide for the BaldrickInput1", board_page_path('baldrickinput1', 'getting-started'), class: "text-blue-600 hover:text-blue-800 underline"}.
            | It's similar but you've got an extra 7 inputs to play with!

    .flex.flex-col.sm:flex-row.gap-4.mt-8
      = link_to 'BaldrickInput1 Getting Started Guide', board_page_path('baldrickinput1', 'getting-started'), class: 'bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors inline-flex items-center justify-center'
      = link_to 'Web Interface Guide', board_page_path('baldrickinput8', 'web-interface'), class: 'bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition-colors inline-flex items-center justify-center'
      = link_to 'Technical Specifications', board_page_path('baldrickinput8', 'tech-specs'), class: 'bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition-colors inline-flex items-center justify-center'
