- content_for :title, "All Boards - Baldrick Board Documentation"

.max-w-6xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8
  / Breadcrumb
  = render 'shared/breadcrumbs', breadcrumbs: [{ title: 'Home', path: '/' }, { title: 'All Boards', path: nil }]

  / Main Content Card
  .bg-white.rounded-lg.shadow-lg.overflow-hidden
    / Header Section
    = render 'shared/page_header', title: 'All Baldrick Boards', subtitle: 'Explore our complete range of controller boards for various applications', image_url: 'baldrick8/board.png', image_alt: 'Baldrick8 Board'

    / Content Section
    .px-8.py-8
      .max-w-4xl.mx-auto
        .grid.md:grid-cols-2.lg:grid-cols-3.gap-6
          = board_card('baldrick8')
          = board_card('baldrick17')
          = board_card('baldrickswitchy')
          = board_card('baldrickdmx')
          = board_card('baldrickinput1')
          = board_card('baldrickinput8')
          = board_card('baldrickbadge')
          / BaldrickBuck removed - not ready for launch
          = board_card('baldricksignals')
