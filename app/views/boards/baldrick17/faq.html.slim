- content_for :title, "FAQ - Baldrick17 - Baldrick Board Documentation"

/ Board Submenu
= render 'boards/shared/board_submenu', board_name: 'Baldrick17', menu_items: board_menu_items('baldrick17')

.max-w-6xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8
  / Breadcrumb
  = render 'shared/breadcrumbs', breadcrumbs: board_breadcrumbs('baldrick17', 'FAQ')

  / Main Content Card
  .bg-white.rounded-lg.shadow-lg.overflow-hidden
    / Header Section
    = render 'shared/page_header', title: 'Frequently Asked Questions', subtitle: 'Common questions about Baldrick17'

    / Content Section
    .px-8.py-8
      .max-w-4xl.mx-auto
        / FAQ for Baldrick17
        .prose.max-w-none
          h2.text-3xl.font-bold.text-gray-900.mb-6 Baldrick17 FAQ

          p.text-lg.text-gray-700.mb-6
            | Find answers to the most commonly asked questions about the Baldrick17 controller.

          .space-y-8
            .bg-gray-50.rounded-lg.p-6.border.border-gray-200
              h3.text-xl.font-semibold.text-gray-900.mb-3 Coming Soon
              p.text-gray-700.mb-4
                | The Baldrick17 board hasn't been released yet, so we don't have any frequently asked questions for it at this time.
              p.text-gray-700
                | In the meantime, check out our 
                = link_to "getting started guide", board_page_path('baldrick17', 'getting-started'), class: "text-blue-600 hover:text-blue-800 underline"
                |  for detailed information about using your Baldrick17.

            = render 'boards/shared/faq_ending'
